/**
 * BHGY Plantation Post-Test — Google Apps Script web app
 * - Serves the timed bilingual test (Index.html)
 * - On submit: re-scores on the server, emails the participant their result
 *   and full answer key with explanations, and logs the result to a Google Sheet.
 *
 * SETUP (one time, ~5 minutes) — see the steps in README.txt
 */

// ---------- settings ----------
var PASS_PERCENT  = 75;   // pass mark in percent (keep same as Index.html)
var TRAINER_EMAIL = "";   // optional: every result is also copied (BCC) to this address
var SHEET_NAME    = "Results";
var LETTERS = ["A", "B", "C", "D", "E"];
var PAPER_SIZE = 30;      // questions per participant (drawn at random from the bank in Index.html)

var QUESTIONS = [{"type": "single", "q": {"en": "Birsa Harit Gram Yojana (BHGY) in Jharkhand is a plantation scheme implemented under which programme?", "hi": "झारखण्ड में बिरसा हरित ग्राम योजना (BHGY) किस कार्यक्रम के अंतर्गत चलाई जाने वाली वृक्षारोपण योजना है?"}, "opts": [{"en": "PM-KISAN", "hi": "पीएम-किसान"}, {"en": "MGNREGA / VB-G RAM G", "hi": "मनरेगा / VB-G RAM G"}, {"en": "PMAY-G (housing)", "hi": "प्रधानमंत्री आवास योजना-ग्रामीण"}, {"en": "National Horticulture Board only", "hi": "केवल राष्ट्रीय बागवानी बोर्ड"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [1], "exp": {"en": "The BHGY booklet says: the plantation scheme implemented under MGNREGA / VB-G RAM G in Jharkhand is called Birsa Harit Gram Yojana. Wages and materials for pit digging, planting and 5 years of care come from MGNREGA / VB-G RAM G.", "hi": "बागवानी पुस्तिका के अनुसार झारखण्ड में मनरेगा / VB-G RAM G अंतर्गत क्रियान्वित वृक्षारोपण की योजना को ही बिरसा हरित ग्राम योजना कहते हैं। गड्ढा खुदाई, रोपाई और 5 साल की देखभाल की मजदूरी व सामग्री मनरेगा / VB-G RAM G से मिलती है।"}, "src": "BHGY Booklet (2022), p.11"}, {"type": "single", "q": {"en": "Before it was renamed Birsa Harit Gram Yojana in FY 2020-21, the mango plantation scheme was known as:", "hi": "वित्तीय वर्ष 2020-21 में बिरसा हरित ग्राम योजना नाम रखे जाने से पहले आम बागवानी की यह योजना किस नाम से जानी जाती थी?"}, "opts": [{"en": "Birsa Munda Aam Bagwani Yojana", "hi": "बिरसा मुण्डा आम बागवानी योजना"}, {"en": "Didi Bagiya Yojana", "hi": "दीदी बगिया योजना"}, {"en": "Birsa Sinchai Koop Samvardhan Yojana", "hi": "बिरसा सिंचाई कूप संवर्धन योजना"}, {"en": "Jharkhand Horticulture Mission", "hi": "झारखण्ड बागवानी मिशन"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "A pilot of mango orchards under MGNREGA / VB-G RAM G began in 2016-17 (4 districts, 9 blocks, 32 panchayats, about 500 schemes). It was named 'Birsa Munda Aam Bagwani Yojana', and in 2020-21, with extra provisions added, it became 'Birsa Harit Gram Yojana'.", "hi": "मनरेगा / VB-G RAM G अंतर्गत आम बागवानी का पायलट 2016-17 में (4 जिले, 9 प्रखंड, 32 पंचायत, लगभग 500 योजनाएं) शुरू हुआ। इसका नाम 'बिरसा मुण्डा आम बागवानी योजना' रखा गया और 2020-21 में कुछ नए प्रावधान जोड़कर इसे 'बिरसा हरित ग्राम योजना' कहा गया।"}, "src": "Bagwani Sakhi Protsahan Niti (N) 85, 11.03.2024, section 1"}, {"type": "single", "q": {"en": "Which families can get a BHGY fruit orchard on their own land (individual scheme)?", "hi": "बिरसा हरित ग्राम योजना में अपनी जमीन पर फलदार बागवानी (व्यक्तिगत योजना) का लाभ किन परिवारों को मिल सकता है?"}, "opts": [{"en": "SC / ST / PVTG families", "hi": "अनुसूचित जाति / अनुसूचित जनजाति / आदिम जनजाति परिवार"}, {"en": "BPL families and women-headed families", "hi": "गरीबी रेखा से नीचे (BPL) और महिला प्रधान परिवार"}, {"en": "Small farmers (2.5–5 acres) and marginal farmers (up to 2.5 acres)", "hi": "लघु किसान (2.5–5 एकड़) और सीमान्त किसान (2.5 एकड़ तक)"}, {"en": "Families headed by a person with disability, and PMAY/IAY beneficiaries", "hi": "विकलांग प्रधान परिवार तथा PMAY/IAY के लाभार्थी"}, {"en": "All of these", "hi": "उपरोक्त सभी"}], "ans": [4], "exp": {"en": "All these categories are eligible for individual MGNREGA / VB-G RAM G works: SC, ST, PVTG, BPL, women-headed, disabled-headed, land-reform beneficiaries, IAY/PMAY beneficiaries, FRA beneficiaries, small and marginal farmers. The family should also depend on farming and have a job card and bank account.", "hi": "ये सभी श्रेणियां पात्र हैं: SC, ST, आदिम जनजाति, BPL, महिला प्रधान, विकलांग प्रधान, भूमि सुधार के हितग्राही, IAY/PMAY लाभार्थी, वन अधिकार अधिनियम के हितग्राही, लघु व सीमान्त किसान। साथ ही परिवार की आजीविका खेती पर आधारित हो और जॉब कार्ड व बैंक खाता हो।"}, "src": "BHGY Booklet p.12; BHGY Guidelines (N) 350, 19.03.2024"}, {"type": "single", "q": {"en": "On raiyati (own) land, what is the area limit for one family's fruit plantation?", "hi": "रैयती जमीन पर एक परिवार अधिकतम और न्यूनतम कितने क्षेत्र में फलदार बागवानी कर सकता है?"}, "opts": [{"en": "Minimum 50 decimal (25 decimal if in a patch/cluster), maximum 1 acre", "hi": "न्यूनतम 50 डिसमिल (पैच/क्लस्टर में 25 डिसमिल), अधिकतम 1 एकड़"}, {"en": "Minimum 1 acre, maximum 5 acres", "hi": "न्यूनतम 1 एकड़, अधिकतम 5 एकड़"}, {"en": "Minimum 10 decimal, maximum 2 acres", "hi": "न्यूनतम 10 डिसमिल, अधिकतम 2 एकड़"}, {"en": "Minimum 50 decimal, no upper limit", "hi": "न्यूनतम 50 डिसमिल, अधिकतम की कोई सीमा नहीं"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "If plantation is done together in a patch (cluster), one beneficiary can take at least 25 decimal; otherwise at least 50 decimal. In both cases the maximum is 1 acre.", "hi": "यदि कई लाभुक एक साथ पैच (क्लस्टर) में बागवानी करें तो एक लाभुक कम से कम 25 डिसमिल, अन्यथा कम से कम 50 डिसमिल में बागवानी कर सकता है। दोनों स्थितियों में अधिकतम सीमा 1 एकड़ है।"}, "src": "BHGY Guidelines (N) 350, p.9; BHGY Booklet p.14"}, {"type": "multi", "q": {"en": "Which of these are correct criteria for choosing land (patch) for a fruit orchard? (Select all that apply)", "hi": "फलदार बागवानी के लिए जमीन (पैच) चुनने के सही मानदंड कौन-से हैं? (सभी सही विकल्प चुनें)"}, "opts": [{"en": "Slope of land less than 8%", "hi": "जमीन की ढलान 8% से कम हो"}, {"en": "Soil depth at least 1 metre", "hi": "मिट्टी की गहराई कम से कम 1 मीटर हो"}, {"en": "A year-round irrigation source within 100 metres", "hi": "100 मीटर के अंदर साल भर सिंचाई का साधन हो"}, {"en": "Land where water collects (waterlogging) is preferred", "hi": "जहाँ पानी जमा होता है (जल जमाव) वह जमीन बेहतर है"}, {"en": "Land with many big trees and bushes is preferred", "hi": "जहाँ बड़े पेड़ और झाड़ियाँ अधिक हों वह जमीन बेहतर है"}], "ans": [0, 1, 2], "exp": {"en": "Choose land with slope below 8%, soil at least 1 m deep, irrigation within 100 m all year, no waterlogging and no legal dispute. Avoid land with many big trees or bushes — young plants lose sunlight and nutrients to them.", "hi": "ढलान 8% से कम, मिट्टी कम से कम 1 मीटर गहरी, 100 मीटर के अंदर साल भर सिंचाई, जल जमाव न हो और कोई कानूनी विवाद न हो। बड़े पेड़ व झाड़ियों वाली जमीन न चुनें — छोटे पौधों को धूप और पोषण नहीं मिलता।"}, "src": "BHGY Guidelines (N) 350, p.10; BHGY Booklet p.13"}, {"type": "single", "q": {"en": "In the BHGY mango plantation model for 1 acre, how many plants are planted in total?", "hi": "बिरसा हरित ग्राम योजना के 1 एकड़ आम बागवानी मॉडल में कुल कितने पौधे लगाए जाते हैं?"}, "opts": [{"en": "100 plants", "hi": "100 पौधे"}, {"en": "150 plants", "hi": "150 पौधे"}, {"en": "192 plants", "hi": "192 पौधे"}, {"en": "260 plants", "hi": "260 पौधे"}, {"en": "400 plants", "hi": "400 पौधे"}], "ans": [2], "exp": {"en": "1 acre = 192 plants: 112 mango inside the plot and 80 timber/fodder plants along the border. Estimated cost is about ₹3.40 lakh, with 6 jalkunds per acre.", "hi": "1 एकड़ = 192 पौधे: अंदर 112 आम और किनारे (बॉर्डर) पर 80 इमारती/चारा पौधे। अनुमानित लागत लगभग ₹3.40 लाख है और प्रति एकड़ 6 जलकुंड बनते हैं।"}, "src": "BHGY Booklet p.14"}, {"type": "single", "q": {"en": "What is the plant-to-plant distance between two mango plants in the BHGY layout?", "hi": "बिरसा हरित ग्राम योजना के ले-आउट में आम के एक पौधे से दूसरे पौधे की दूरी कितनी होती है?"}, "opts": [{"en": "3 m × 3 m", "hi": "3 मीटर × 3 मीटर"}, {"en": "5 m × 5 m", "hi": "5 मीटर × 5 मीटर"}, {"en": "8 m × 8 m", "hi": "8 मीटर × 8 मीटर"}, {"en": "10 m × 10 m", "hi": "10 मीटर × 10 मीटर"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [1], "exp": {"en": "Mango (Amrapali/Mallika) is planted at 5 m × 5 m. In mixed orchards mango and guava are planted one after another, also at 5 × 5 m.", "hi": "आम (आम्रपाली/मल्लिका) 5 मीटर × 5 मीटर पर लगाया जाता है। मिश्रित बागवानी में आम और अमरूद एक के बाद एक, 5 × 5 मीटर पर ही लगते हैं।"}, "src": "BHGY Booklet pp.15–17"}, {"type": "single", "q": {"en": "What is the pit size for a fruit plant (mango, guava) in BHGY?", "hi": "फलदार पौधे (आम, अमरूद) के लिए गड्ढे का आकार क्या होता है?"}, "opts": [{"en": "1 ft × 1 ft × 1 ft", "hi": "1 फीट × 1 फीट × 1 फीट"}, {"en": "2 ft × 2 ft × 2 ft", "hi": "2 फीट × 2 फीट × 2 फीट"}, {"en": "3 ft × 3 ft × 3 ft", "hi": "3 फीट × 3 फीट × 3 फीट"}, {"en": "4 ft × 4 ft × 4 ft", "hi": "4 फीट × 4 फीट × 4 फीट"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [2], "exp": {"en": "Fruit plant pit = 3 × 3 × 3 ft. Timber/border plant pit = 2 × 2 × 2 ft.", "hi": "फलदार पौधे का गड्ढा = 3 × 3 × 3 फीट। इमारती/बॉर्डर पौधे का गड्ढा = 2 × 2 × 2 फीट।"}, "src": "BHGY Booklet pp.15–16"}, {"type": "single", "q": {"en": "Timber plants are planted along the orchard border. How far inside the ridge (medh) and at what spacing?", "hi": "इमारती पौधे बागान के किनारे लगाए जाते हैं। ये मेढ़ से कितनी दूरी पर और आपस में कितनी दूरी पर लगते हैं?"}, "opts": [{"en": "2.5 m inside the ridge, 3 m apart", "hi": "मेढ़ से 2.5 मीटर अंदर, आपस में 3 मीटर"}, {"en": "1 m inside the ridge, 5 m apart", "hi": "मेढ़ से 1 मीटर अंदर, आपस में 5 मीटर"}, {"en": "5 m inside the ridge, 5 m apart", "hi": "मेढ़ से 5 मीटर अंदर, आपस में 5 मीटर"}, {"en": "7.5 m inside the ridge, 3 m apart", "hi": "मेढ़ से 7.5 मीटर अंदर, आपस में 3 मीटर"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Timber line: 2.5 m inside the ridge, plants 3 m apart. The first mango line is 7.5 m from the ridge, i.e. 5 m inside the timber line.", "hi": "इमारती पौधों की लाइन मेढ़ से 2.5 मीटर अंदर, पौधों के बीच 3 मीटर। आम की पहली लाइन मेढ़ से 7.5 मीटर, यानी इमारती लाइन से 5 मीटर अंदर होती है।"}, "src": "BHGY Booklet pp.15, 19"}, {"type": "single", "q": {"en": "During layout, the '3-4-5 rule' is used for:", "hi": "ले-आउट के समय '3-4-5 नियम' का उपयोग किसलिए किया जाता है?"}, "opts": [{"en": "Measuring pit depth", "hi": "गड्ढे की गहराई मापने के लिए"}, {"en": "Making a 90° (right) angle so lines are straight", "hi": "90° (समकोण) बनाने के लिए ताकि लाइन सीधी रहे"}, {"en": "Counting the number of plants", "hi": "पौधों की संख्या गिनने के लिए"}, {"en": "Deciding the fertilizer dose", "hi": "खाद की मात्रा तय करने के लिए"}, {"en": "All of these", "hi": "उपरोक्त सभी"}], "ans": [1], "exp": {"en": "Mark 3 m, 7 m and 12 m on a measuring tape and join the 0 and 12 m points: sides of 3, 4 and 5 m make a right angle. This keeps plant rows straight and spacing equal.", "hi": "फीते पर 3 मीटर, 7 मीटर और 12 मीटर पर निशान लगाएं और 0 व 12 मीटर वाले बिंदु मिलाएं: 3, 4 और 5 मीटर की भुजाओं से समकोण बनता है। इससे पौधों की कतारें सीधी और दूरी बराबर रहती है।"}, "src": "BHGY Booklet p.19; Litchi SoP p.7"}, {"type": "multi", "q": {"en": "Which are correct practices for pit digging and pit filling? (Select all that apply)", "hi": "गड्ढा खुदाई और गड्ढा भराई के सही तरीके कौन-से हैं? (सभी सही विकल्प चुनें)"}, "opts": [{"en": "Keep the top 1 ft soil separate from the lower 2 ft soil", "hi": "ऊपर की 1 फीट मिट्टी को नीचे की 2 फीट मिट्टी से अलग रखें"}, {"en": "Leave the dug pit open in the sun for 20–30 days", "hi": "खुदे गड्ढे को 20–30 दिन खुली धूप में छोड़ दें"}, {"en": "While filling, put the top soil in first", "hi": "भराई के समय ऊपर वाली मिट्टी पहले डालें"}, {"en": "Use the stones that come out of the pit for filling", "hi": "गड्ढे से निकले पत्थरों को भराई में उपयोग करें"}, {"en": "Fill the pits only after the rainy season ends", "hi": "गड्ढे की भराई बरसात खत्म होने के बाद ही करें"}], "ans": [0, 1, 2], "exp": {"en": "Keep top 1 ft soil separately, remove stones, leave the pit in the sun for 20–30 days (sunlight kills germs and lets air in), then fill top soil first, mixed with compost, before the rains. Fill up to 1 ft above ground and fix a stick in the centre.", "hi": "ऊपरी 1 फीट मिट्टी अलग रखें, पत्थर निकाल दें, गड्ढे को 20–30 दिन धूप में छोड़ें (धूप से कीटाणु नष्ट होते हैं और हवा मिलती है), फिर बरसात से पहले खाद मिलाकर ऊपर वाली मिट्टी पहले भरें। भराई जमीन से 1 फीट ऊँचाई तक करें और बीच में डंडा गाड़ दें।"}, "src": "BHGY Booklet pp.20–21"}, {"type": "single", "q": {"en": "If Trichoderma-enriched compost has been applied at planting, which fungicide should be put in the root-zone soil?", "hi": "यदि रोपाई के समय ट्राईकोडर्मा युक्त खाद डाली गई है, तो जड़ की मिट्टी में कौन-सा फफूंदनाशक डालना चाहिए?"}, "opts": [{"en": "Copper oxychloride", "hi": "कॉपर ऑक्सीक्लोराइड"}, {"en": "Chlorothalonil", "hi": "क्लोरोथलोनिल"}, {"en": "Carbendazim", "hi": "कार्बेन्डाजिम"}, {"en": "Blue copper", "hi": "ब्लू कॉपर"}, {"en": "None of these — no fungicide should be used in the root soil", "hi": "इनमें से कोई नहीं — जड़ की मिट्टी में फफूंदनाशक नहीं डालना है"}], "ans": [4], "exp": {"en": "Trichoderma is a friendly fungus that protects roots from soil-borne fungal disease. A chemical fungicide would kill it, so when Trichoderma compost is used, do not apply fungicide to the root soil.", "hi": "ट्राईकोडर्मा एक मित्र फफूंद है जो जड़ों को मिट्टी जनित फफूंद रोग से बचाता है। रासायनिक फफूंदनाशक इसे भी मार देगा, इसलिए ट्राईकोडर्मा युक्त खाद डालने पर जड़ की मिट्टी में फफूंदनाशक का प्रयोग न करें।"}, "src": "BHGY Booklet p.21; Litchi SoP p.9"}, {"type": "single", "q": {"en": "What are the standard dimensions of a Cattle Proof Trench (CPT) in BHGY?", "hi": "बिरसा हरित ग्राम योजना में पशु रोधक खाई (CPT) का मानक आकार क्या है?"}, "opts": [{"en": "6 ft wide at top, 3 ft at bottom, 4 ft deep", "hi": "ऊपर 6 फीट चौड़ी, नीचे 3 फीट, 4 फीट गहरी"}, {"en": "3 ft at top, 6 ft at bottom, 2 ft deep", "hi": "ऊपर 3 फीट, नीचे 6 फीट, 2 फीट गहरी"}, {"en": "4 ft × 4 ft × 4 ft", "hi": "4 फीट × 4 फीट × 4 फीट"}, {"en": "6 ft at top, 6 ft at bottom, 6 ft deep", "hi": "ऊपर 6 फीट, नीचे 6 फीट, 6 फीट गहरी"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "CPT: top width 6 ft, bottom 3 ft, depth 4 ft (cross-section 18 sq ft). Each trench is 9 ft long (3 person-days), then a 1 ft 'equalizer' is left before the next one. Near a village it is dug inside the fencing so children do not fall in.", "hi": "CPT: ऊपर 6 फीट, नीचे 3 फीट, गहराई 4 फीट (18 वर्ग फीट)। एक खाई 9 फीट लम्बी (3 मानव दिवस), फिर 1 फीट 'इक्वलाइजर' छोड़कर अगली खाई। गाँव के पास बागान हो तो खाई घेरान के अंदर बनाते हैं ताकि बच्चे न गिरें।"}, "src": "BHGY Booklet p.26"}, {"type": "single", "q": {"en": "Which statement about live fencing (jinda gheran) under MGNREGA / VB-G RAM G is correct?", "hi": "मनरेगा / VB-G RAM G अंतर्गत जिन्दा घेरान के बारे में कौन-सा कथन सही है?"}, "opts": [{"en": "5 ft high; 1 person-day per 20 ft; ₹8 per ft for material", "hi": "5 फीट ऊँचा; प्रति 20 फीट पर 1 मानव-दिवस; सामग्री हेतु ₹8 प्रति फीट"}, {"en": "3 ft high; 1 person-day per 10 ft; ₹5 per ft", "hi": "3 फीट ऊँचा; प्रति 10 फीट पर 1 मानव-दिवस; ₹5 प्रति फीट"}, {"en": "6 ft high; 1 person-day per 50 ft; ₹10 per ft", "hi": "6 फीट ऊँचा; प्रति 50 फीट पर 1 मानव-दिवस; ₹10 प्रति फीट"}, {"en": "5 ft high; no material cost is allowed", "hi": "5 फीट ऊँचा; सामग्री का कोई खर्च नहीं मिलता"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Live fencing uses a bamboo frame with local shrubs that take root (e.g. lantana/putus, sindwar). It is 5 ft high on the outer boundary; 1 person-day is paid for every 20 ft and ₹8 per running foot for material. Plants are placed 2.5 m from the fence.", "hi": "जिन्दा घेरान में बांस के ढांचे के साथ स्थानीय झाड़ियाँ (पुटुस, सिन्दवार आदि) लगाई जाती हैं जो जड़ पकड़ लें। बाहरी सीमा पर 5 फीट ऊँचा घेरान; प्रति 20 फीट पर 1 मानव-दिवस और सामग्री हेतु ₹8 प्रति फीट। पौधे घेरान से 2.5 मीटर दूरी पर लगते हैं।"}, "src": "BHGY Booklet p.25"}, {"type": "multi", "q": {"en": "Which statements about the jalkund (small water tank) are correct? (Select all that apply)", "hi": "जलकुंड के बारे में कौन-से कथन सही हैं? (सभी सही विकल्प चुनें)"}, "opts": [{"en": "Size is 3 m long × 1.5 m wide × 1 m deep", "hi": "आकार 3 मीटर लम्बा × 1.5 मीटर चौड़ा × 1 मीटर गहरा"}, {"en": "It is lined with UV-stabilised black polythene sheet", "hi": "इसमें UV-स्टेबलाइज्ड काली पॉलीथीन शीट बिछाई जाती है"}, {"en": "It can store up to about 4,000 litres of water", "hi": "इसमें लगभग 4,000 लीटर तक पानी जमा हो सकता है"}, {"en": "6 jalkunds are made per acre (1 for every 30–40 plants)", "hi": "प्रति एकड़ 6 जलकुंड बनते हैं (हर 30–40 पौधों पर 1)"}, {"en": "Only 1 jalkund is made for 4 acres", "hi": "4 एकड़ पर केवल 1 जलकुंड बनता है"}], "ans": [0, 1, 2, 3], "exp": {"en": "Jalkund: 3 × 1.5 × 1 m (10 × 5 × 3 ft), lined with 6 kg (250 thick) UV-stabilised black polythene sheet, holds up to 4,000 L. 6 per acre, i.e. one for 30–40 plants. It is covered after the rains to reduce evaporation.", "hi": "जलकुंड: 3 × 1.5 × 1 मीटर (10 × 5 × 3 फीट), 6 किलो (250 थिक) UV-स्टेबलाइज्ड काली पॉलीथीन शीट, 4,000 लीटर तक पानी। प्रति एकड़ 6, यानी 30–40 पौधों पर एक। बरसात के बाद वाष्पीकरण रोकने के लिए ढक दिया जाता है।"}, "src": "BHGY Booklet p.28"}, {"type": "single", "q": {"en": "Read the statements about intercropping (crops inside the orchard):\n(i) The intercrop should not grow taller than the fruit plant.\n(ii) Creeper crops should not be allowed to climb on fruit plants.\n(iii) Intercropping increases the death rate of fruit plants.\nWhich are correct?", "hi": "अंतःफसल (बागान के अंदर खेती) के बारे में कथन पढ़ें:\n(i) अंतःफसल की ऊँचाई फलदार पौधे से ज्यादा नहीं होनी चाहिए।\n(ii) लत्तर वाली फसल को फलदार पौधों पर नहीं चढ़ाना चाहिए।\n(iii) अंतःफसल से फलदार पौधों की मृत्यु-दर बढ़ती है।\nकौन-से कथन सही हैं?"}, "opts": [{"en": "Only (i)", "hi": "केवल (i)"}, {"en": "Only (ii)", "hi": "केवल (ii)"}, {"en": "Only (i) and (ii)", "hi": "केवल (i) और (ii)"}, {"en": "All of (i), (ii) and (iii)", "hi": "(i), (ii) और (iii) सभी"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [2], "exp": {"en": "(i) and (ii) are rules in the booklet. (iii) is wrong: orchards with intercropping had very low plant death, because farmers visit daily and the manure, water and care given to the crop also reach the fruit plants.", "hi": "(i) और (ii) पुस्तिका के नियम हैं। (iii) गलत है: जिन बागानों में अंतःफसल हुई उनमें पौधों की मृत्यु-दर बहुत कम पाई गई, क्योंकि किसान रोज आता है और फसल को दी गई खाद, पानी व देखभाल फलदार पौधों को भी मिलती है।"}, "src": "BHGY Booklet p.29; BHGY Guidelines (N) 350"}, {"type": "multi", "q": {"en": "As per the BHGY guidelines, which of these are listed as WINTER-season (Rabi) intercrops? (Select all that apply)", "hi": "बिरसा हरित ग्राम योजना मार्गदर्शिका के अनुसार इनमें से कौन-सी शीत ऋतु (रबी) की अंतःफसल हैं? (सभी सही विकल्प चुनें)"}, "opts": [{"en": "Cauliflower", "hi": "फूलगोभी"}, {"en": "Peas", "hi": "मटर"}, {"en": "Potato", "hi": "आलू"}, {"en": "Turmeric", "hi": "हल्दी"}, {"en": "Watermelon", "hi": "तरबूज"}], "ans": [0, 1, 2], "exp": {"en": "Winter: cauliflower, cabbage, broccoli, tomato, peas, potato, coriander, spinach, carrot, radish, onion, garlic etc. Turmeric and ginger are rainy-season crops; watermelon, bitter gourd and okra are summer crops.", "hi": "शीत ऋतु: फूलगोभी, बंधगोभी, ब्रोकोली, टमाटर, मटर, आलू, धनिया, पालक, गाजर, मूली, प्याज, लहसुन आदि। हल्दी और अदरक वर्षा ऋतु की फसल हैं; तरबूज, करैला, भिण्डी ग्रीष्म ऋतु की।"}, "src": "BHGY Guidelines (N) 350, 19.03.2024 — intercrop table"}, {"type": "single", "q": {"en": "Which is the correct sequence of the three phases of BHGY plantation work?", "hi": "बिरसा हरित ग्राम योजना वृक्षारोपण के तीन चरणों का सही क्रम कौन-सा है?"}, "opts": [{"en": "Advance work (Year 1: layout, pit digging, CPT, NADEP, tenders) → Completion work (Year 2: fencing, pit filling, planting) → Maintenance (Years 3–5)", "hi": "एडवांस कार्य (प्रथम वर्ष: ले-आउट, गड्ढा खुदाई, CPT, नाडेप, निविदा) → कम्प्लीशन कार्य (द्वितीय वर्ष: घेरान, गड्ढा भराई, रोपण) → रख-रखाव (तृतीय से पंचम वर्ष)"}, {"en": "All work, including maintenance, is finished in one year", "hi": "रख-रखाव सहित सारा काम एक ही वर्ष में पूरा"}, {"en": "Planting in Year 1, pit digging in Year 2", "hi": "प्रथम वर्ष रोपण, द्वितीय वर्ष गड्ढा खुदाई"}, {"en": "Advance work → Completion work, with no maintenance after planting", "hi": "एडवांस कार्य → कम्प्लीशन कार्य, रोपण के बाद कोई रख-रखाव नहीं"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Advance work must be completed by March of Year 1. Year 2 is the Completion year (fencing, pit filling, planting, H-stake, weeding, intercrop, manure). Years 3–5 are Maintenance (fence repair, pruning, manure, irrigation, pest control, removing flowers).", "hi": "एडवांस कार्य प्रथम वर्ष मार्च तक पूरा करना है। द्वितीय वर्ष कम्प्लीशन वर्ष है (घेरान, गड्ढा भराई, रोपण, H-टेका, निकाई, अंतःफसल, खाद)। तृतीय से पंचम वर्ष रख-रखाव (घेरान मरम्मत, कटाई-छँटाई, खाद, सिंचाई, कीट नियंत्रण, मंजर तोड़ना)।"}, "src": "BHGY Guidelines (N) 350, p.2"}, {"type": "single", "q": {"en": "According to the BHGY activity calendar, planting of saplings should be completed during:", "hi": "बिरसा हरित ग्राम योजना की समय-सारणी के अनुसार पौधा रोपण का कार्य कब तक पूरा करना है?"}, "opts": [{"en": "January – February", "hi": "जनवरी – फरवरी"}, {"en": "April – May", "hi": "अप्रैल – मई"}, {"en": "15 June to 15 July (after the rains begin)", "hi": "15 जून से 15 जुलाई (वर्षा आरम्भ होने पर)"}, {"en": "October – November", "hi": "अक्टूबर – नवम्बर"}, {"en": "Any time of the year", "hi": "साल में कभी भी"}], "ans": [2], "exp": {"en": "Pits and fencing should be ready by end of April/May. Planting is done from 15 June to 15 July once the rains start and the soil is moist; the H-stake is fixed by July.", "hi": "गड्ढा और घेरान अप्रैल/मई तक तैयार हो। वर्षा आरम्भ होने और मिट्टी में नमी आने पर 15 जून से 15 जुलाई तक रोपण पूरा करें; जुलाई तक H-टेका लगा दें।"}, "src": "BHGY Guidelines (N) 350, timeline item 19"}, {"type": "single", "q": {"en": "In the early years of a young mango orchard, what should be done with the flowers (manjar) that appear?", "hi": "नए आम बागान के शुरुआती वर्षों में जो मंजर (फूल) आते हैं, उनके साथ क्या करना चाहिए?"}, "opts": [{"en": "Leave them so the plant gives fruit early", "hi": "छोड़ दें ताकि पौधा जल्दी फल दे"}, {"en": "Remove them by crushing with the hand", "hi": "हाथ से मसलकर हटा दें"}, {"en": "Spray urea on them", "hi": "उन पर यूरिया का छिड़काव करें"}, {"en": "Cover them with a polythene bag", "hi": "उन्हें पॉलीथीन से ढक दें"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [1], "exp": {"en": "The monthly calendar says to crush the manjar by hand in the early years. This lets the young plant put its energy into growing a strong frame instead of fruit.", "hi": "मासिक कार्य-सारणी के अनुसार शुरुआती वर्षों में मंजर को हाथ से मसलकर हटाना है। इससे छोटा पौधा फल की जगह अपनी ताकत मजबूत ढांचा बनाने में लगाता है।"}, "src": "BHGY Booklet pp.50, 53"}, {"type": "multi", "q": {"en": "Which statements about mulching are correct? (Select all that apply)", "hi": "मल्चिंग के बारे में कौन-से कथन सही हैं? (सभी सही विकल्प चुनें)"}, "opts": [{"en": "It keeps moisture in the basin for longer in summer", "hi": "गर्मी में थाले में नमी अधिक समय तक बनी रहती है"}, {"en": "The mulch decomposes and works as manure", "hi": "मल्च सड़कर खाद का काम करता है"}, {"en": "Dry mulch should be pressed against the stem", "hi": "सूखी मल्च को तने से सटाकर रखना चाहिए"}, {"en": "Green leaves/grass can be used; if not available, dry grass or stones", "hi": "हरी पत्ती/घास का प्रयोग करें; न हो तो सूखी घास या पत्थर भी"}, {"en": "Mulching should never be done in summer", "hi": "गर्मी में मल्चिंग कभी नहीं करनी चाहिए"}], "ans": [0, 1, 3], "exp": {"en": "Mulch the basin ring with green leaves or grass (or dry grass/stones). It saves moisture and later becomes manure. Keep dry mulch away from the stem — touching the stem invites termites; spray termiticide if termites appear.", "hi": "थाले की रिंग में हरी पत्ती या घास (या सूखी घास/पत्थर) से मल्च करें। इससे नमी बचती है और बाद में यह खाद बनता है। सूखी मल्च तने से न सटाएं — इससे दीमक लगने का खतरा होता है; दीमक दिखने पर दीमकनाशक का छिड़काव करें।"}, "src": "BHGY Booklet p.33"}, {"type": "single", "q": {"en": "How often should a first-year plant be irrigated in the summer season?", "hi": "पहले वर्ष के पौधे को गर्मी के मौसम में कितने अंतराल पर सिंचाई करनी चाहिए?"}, "opts": [{"en": "Every 2–3 days", "hi": "हर 2–3 दिन में"}, {"en": "Once a month", "hi": "महीने में एक बार"}, {"en": "Every 10 days", "hi": "हर 10 दिन में"}, {"en": "No irrigation is needed", "hi": "सिंचाई की आवश्यकता नहीं"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "In the first year roots are small, so irrigate every 2–3 days in summer. Plants aged 2–5 years need water every 3–4 days in summer. Irrigation in winter also reduces frost damage.", "hi": "पहले वर्ष में जड़ें कम विकसित होती हैं, इसलिए गर्मी में हर 2–3 दिन पर सिंचाई करें। 2 से 5 वर्ष के पौधों को गर्मी में 3–4 दिन के अंतराल पर पानी दें। ठंड में सिंचाई से पाले का नुकसान भी कम होता है।"}, "src": "BHGY Booklet p.34"}, {"type": "single", "q": {"en": "Anthracnose, which attacks new leaves, twigs and fruits of mango, is:", "hi": "आम की नई पत्तियों, टहनियों और फलों पर लगने वाला एन्थ्रेक्नोज रोग क्या है?"}, "opts": [{"en": "An insect pest, controlled by neem oil only", "hi": "एक कीट, केवल नीम तेल से नियंत्रण"}, {"en": "A fungal disease, controlled by copper fungicide (blue copper) or chlorothalonil", "hi": "एक फफूंद जनित रोग, कॉपर फफूंदनाशक (ब्लू कॉपर) या क्लोरोथलोनिल से नियंत्रण"}, {"en": "A viral disease with no control", "hi": "एक विषाणु रोग, जिसका कोई उपचार नहीं"}, {"en": "A shortage of water", "hi": "पानी की कमी"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [1], "exp": {"en": "Anthracnose is a fungal disease. Spray a copper fungicide such as blue copper (3 g/L) or chlorothalonil (1 g/L). The calendar recommends this spray in October–January.", "hi": "एन्थ्रेक्नोज फफूंद जनित रोग है। ब्लू कॉपर (3 ग्राम/ली) या क्लोरोथलोनिल (1 ग्राम/ली) जैसे फफूंदनाशक का छिड़काव करें। कार्य-सारणी में अक्टूबर से जनवरी में यह छिड़काव बताया गया है।"}, "src": "BHGY Booklet pp.46, 53"}, {"type": "single", "q": {"en": "Who chairs the village/tola level Plantation User Group (PUG) under BHGY?", "hi": "बिरसा हरित ग्राम योजना में गाँव/टोला स्तरीय वृक्षारोपण लाभुक समिति (PUG) की अध्यक्षता कौन करता है?"}, "opts": [{"en": "Mukhiya", "hi": "मुखिया"}, {"en": "Ward member of that ward", "hi": "संबंधित वार्ड के वार्ड सदस्य"}, {"en": "Block Development Officer", "hi": "प्रखण्ड विकास पदाधिकारी"}, {"en": "Bagwani Sakhi", "hi": "बागवानी सखी"}, {"en": "Gram Rozgar Sevak", "hi": "ग्राम रोजगार सेवक"}], "ans": [1], "exp": {"en": "After schemes are sanctioned, all beneficiaries form a PUG, chaired by the ward member. The ward member raises the group's problems in the monthly Panchayat Executive Committee meeting, with support from the Bagwani Sakhi.", "hi": "योजनाओं की स्वीकृति के बाद सभी लाभुकों की वृक्षारोपण लाभुक समिति (PUG) बनती है, जिसकी अध्यक्षता वार्ड सदस्य करते हैं। वार्ड सदस्य समूह की समस्याओं को 'पंचायत कार्यकारिणी समिति' की मासिक बैठक में रखते हैं; बागवानी सखी सहयोग करती है।"}, "src": "BHGY Guidelines (N) 350, p.10"}, {"type": "single", "q": {"en": "As per the Bagwani Sakhi policy, what is the minimum education, and how much orchard area does one Bagwani Sakhi support?", "hi": "बागवानी सखी प्रोत्साहन नीति के अनुसार न्यूनतम शैक्षणिक योग्यता क्या है और एक बागवानी सखी कितने बागवानी क्षेत्र में सहयोग करती है?"}, "opts": [{"en": "Class 8 pass; at least 5 acres (up to 10 acres if schemes are in patches)", "hi": "आठवीं पास; कम से कम 5 एकड़ (पैच में योजना हो तो 10 एकड़ तक)"}, {"en": "Class 10 pass; 20 acres", "hi": "दसवीं पास; 20 एकड़"}, {"en": "Graduate; 1 acre", "hi": "स्नातक; 1 एकड़"}, {"en": "No education needed; 50 acres", "hi": "कोई योग्यता नहीं; 50 एकड़"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "A Bagwani Sakhi should be at least Class 8 pass. She supports at least 5 acres of orchard; if schemes are in patches she can cover up to 10 acres. If the area is under 5 acres, payment is in proportion to the work.", "hi": "बागवानी सखी कम से कम आठवीं वर्ग उत्तीर्ण हो। वह कम से कम 5 एकड़ बागवानी में सहयोग करेगी; योजनाएं पैच में हों तो 10 एकड़ तक। क्षेत्र 5 एकड़ से कम हो तो कार्य के अनुरूप भुगतान होगा।"}, "src": "Bagwani Sakhi Protsahan Niti (N) 85, sections 3 and 4.1"}, {"type": "multi", "q": {"en": "Which are selection criteria for a Bagwani Sakhi? (Select all that apply)", "hi": "बागवानी सखी के चयन के मापदंड कौन-से हैं? (सभी सही विकल्प चुनें)"}, "opts": [{"en": "She is a didi linked with a Sakhi Mandal (SHG)", "hi": "वह सखी मण्डल (SHG) से जुड़ी दीदी हो"}, {"en": "She can use a smartphone for training material and updates", "hi": "वह स्मार्टफोन से प्रशिक्षण सामग्री देख सके और काम अद्यतन कर सके"}, {"en": "She lives in the same panchayat", "hi": "वह उसी पंचायत की निवासी हो"}, {"en": "She must be a government employee", "hi": "वह सरकारी कर्मचारी हो"}, {"en": "Preference if she has 3+ years' experience in horticulture/farming", "hi": "बागवानी/कृषि में 3 वर्ष या अधिक अनुभव हो तो प्राथमिकता"}], "ans": [0, 1, 2, 4], "exp": {"en": "Criteria: SHG didi, Class 8 pass, willing; can use a smartphone; resident of the same panchayat. Preference for 3+ years' experience, a family orchard, and MGNREGA / VB-G RAM G work in the last 3 years. She is a community cadre, not a government employee.", "hi": "मापदंड: सखी मण्डल की दीदी, आठवीं पास, इच्छुक; स्मार्टफोन चला सके; उसी पंचायत की निवासी। 3 वर्ष अनुभव, परिवार में बागवानी योजना और पिछले 3 वर्ष से मनरेगा / VB-G RAM G मजदूरी करने वाली दीदी को प्राथमिकता। वह सामुदायिक कैडर है, सरकारी कर्मचारी नहीं।"}, "src": "Bagwani Sakhi Protsahan Niti (N) 85, section 4.1"}, {"type": "single", "q": {"en": "As per the BHGY booklet, a Bagwani Sakhi/Mitra gets the full honorarium only when plant survival is:", "hi": "BHGY पुस्तिका के अनुसार बागवानी सखी/मित्र को पूरा मानदेय तभी मिलेगा जब पौधों की उत्तरजीविता हो:"}, "opts": [{"en": "More than 50%", "hi": "50% से अधिक"}, {"en": "More than 70%", "hi": "70% से अधिक"}, {"en": "More than 90%", "hi": "90% से अधिक"}, {"en": "Exactly 100%", "hi": "पूरे 100%"}, {"en": "Survival does not matter", "hi": "उत्तरजीविता से कोई संबंध नहीं"}], "ans": [2], "exp": {"en": "The booklet links honorarium to plant survival: full honorarium only if more than 90% of plants survive. The work is recorded in the form and verified by the Panchayat Secretary/Rozgar Sevak and Mukhiya. (The 2024 Bagwani Sakhi policy moves payment to JSLPS under DAY-NRLM norms.)", "hi": "पुस्तिका के अनुसार मानदेय पौधों की उत्तरजीविता पर आधारित है: 90% से अधिक पौधे जीवित रहने पर ही पूरा मानदेय। कार्य प्रपत्र में भरकर पंचायत सचिव/रोजगार सेवक व मुखिया सत्यापित करते हैं। (2024 की बागवानी सखी नीति में भुगतान JSLPS द्वारा DAY-NRLM मार्गदर्शिका अनुसार है।)"}, "src": "BHGY Booklet p.56"}, {"type": "single", "q": {"en": "For plantation on Gair Majarua (GM / common) land under BHGY, which is correct?", "hi": "गैर-मजरूआ (GM / सामुदायिक) जमीन पर बिरसा हरित ग्राम योजना के वृक्षारोपण के लिए कौन-सा सही है?"}, "opts": [{"en": "One unit = 100 plants; usufruct right (bhogadhikar) to ultra-poor families; at least 10 units per village", "hi": "एक यूनिट = 100 पौधे; अति-गरीब परिवारों को भोगाधिकार (Usufruct right); एक गाँव में कम से कम 10 यूनिट"}, {"en": "One unit = 500 plants; land ownership is transferred to the family", "hi": "एक यूनिट = 500 पौधे; जमीन का मालिकाना हक परिवार को"}, {"en": "One unit = 50 plants; only timber plants", "hi": "एक यूनिट = 50 पौधे; केवल इमारती पौधे"}, {"en": "GM land plantation is not allowed", "hi": "GM जमीन पर वृक्षारोपण की अनुमति नहीं"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "A GM-land unit has 100 plants (24 mango, 24 guava, 22 timber/fodder, 25 lemon, 5 drumstick). Usufruct right is given to ultra-poor SC/ST/landless/PVTG families (or the Gram Panchayat) — not land ownership. At least 10 units per village.", "hi": "GM जमीन की एक यूनिट में 100 पौधे (24 आम, 24 अमरूद, 22 इमारती/चारा, 25 नीम्बू, 5 सहजन)। अति-गरीब SC/ST/भूमिहीन/आदिम जनजाति परिवार (या ग्राम पंचायत) को भोगाधिकार मिलता है — जमीन का मालिकाना हक नहीं। एक गाँव में कम से कम 10 यूनिट।"}, "src": "BHGY Guidelines (N) 350, pp.3–4, 9"}, {"type": "multi", "q": {"en": "Which statements about Kusum and Semialata plantation for lac are correct? (Select all that apply)", "hi": "लाख उत्पादन हेतु कुसुम और सेमियालता वृक्षारोपण के बारे में कौन-से कथन सही हैं? (सभी सही विकल्प चुनें)"}, "opts": [{"en": "Semialata is a legume; its roots store nitrogen in the soil", "hi": "सेमियालता दलहन कुल का है; इसकी जड़ें मिट्टी में नाइट्रोजन संचित करती हैं"}, {"en": "A Semialata plantation is ready for lac in about one year", "hi": "सेमियालता का बागान लगभग एक वर्ष में लाख खेती हेतु तैयार हो जाता है"}, {"en": "Lac can be produced on Kusum about 6 years after planting", "hi": "कुसुम वृक्षारोपण के लगभग 6 वर्ष बाद लाख उत्पादन किया जा सकता है"}, {"en": "Rangeeni lac insects can be reared on Kusum", "hi": "कुसुम पर रंगीनी लाख कीट का पालन किया जा सकता है"}, {"en": "The Kusum-Semialata scheme under BHGY runs for 5 years", "hi": "BHGY में कुसुम-सेमियालता योजना की अवधि 5 वर्ष है"}], "ans": [0, 1, 2], "exp": {"en": "Semialata (a legume that fixes nitrogen) is ready for lac within a year. Kusum gives lac about 6 years after planting and is used for Kusmi lac — Rangeeni lac cannot be reared on it. The BHGY Kusum-Semialata scheme is for 2 years (1 acre: 40 Kusum + 2,044 Semialata + 40 timber).", "hi": "सेमियालता (दलहन कुल, नाइट्रोजन संचित करता है) एक वर्ष में लाख हेतु तैयार होता है। कुसुम पर लगभग 6 वर्ष बाद लाख उत्पादन होता है और इस पर कुसमी लाख पलता है — रंगीनी लाख नहीं। BHGY में कुसुम-सेमियालता योजना 2 वर्ष की है (1 एकड़: 40 कुसुम + 2,044 सेमियालता + 40 इमारती)।"}, "src": "Kusum & Semialata letter (N) 1075, pp.1–7"}, {"type": "single", "q": {"en": "About litchi mixed plantation under BHGY:\n(i) Litchi is chosen only in the mixed model, because it is a large tree species.\n(ii) Jharkhand litchi reaches the market 8–10 days before Muzaffarpur litchi.\n(iii) Litchi plantation can be done without any irrigation source.\nWhich are correct?", "hi": "BHGY अंतर्गत लीची मिश्रित बागवानी के बारे में:\n(i) बड़े प्रजाति का पौधा होने के कारण लीची को केवल मिश्रित बागवानी मॉडल में चुना जाता है।\n(ii) झारखण्ड की लीची मुजफ्फरपुर की लीची से 8–10 दिन पहले बाजार में आती है।\n(iii) लीची बागवानी बिना सिंचाई साधन के भी की जा सकती है।\nकौन-से कथन सही हैं?"}, "opts": [{"en": "Only (i)", "hi": "केवल (i)"}, {"en": "Only (i) and (ii)", "hi": "केवल (i) और (ii)"}, {"en": "Only (iii)", "hi": "केवल (iii)"}, {"en": "All of (i), (ii) and (iii)", "hi": "(i), (ii) और (iii) सभी"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [1], "exp": {"en": "(i) and (ii) are from the Litchi SoP. (iii) is wrong: litchi mixed plantation is done only where year-round irrigation is available. 1 acre = 260 plants (45 litchi + 135 guava/ber/sharifa + 80 timber), about ₹6.01 lakh.", "hi": "(i) और (ii) लीची SoP में दिए गए हैं। (iii) गलत है: लीची मिश्रित बागवानी वहीं होगी जहाँ सालों भर सिंचाई का साधन हो। 1 एकड़ = 260 पौधे (45 लीची + 135 अमरूद/बेर/शरीफा + 80 इमारती), लगभग ₹6.01 लाख।"}, "src": "Litchi Mixed Plantation SoP (N) 881, 26.06.2025, pp.3–5"}, {"type": "single", "q": {"en": "In the BHGY 1-acre MIXED fruit orchard model, how many mango and guava plants are planted in the main plot?", "hi": "BHGY के 1 एकड़ मिश्रित फलदार बागवानी मॉडल में मुख्य प्लॉट में आम और अमरूद के कितने पौधे लगते हैं?"}, "opts": [{"en": "56 mango + 56 guava", "hi": "56 आम + 56 अमरूद"}, {"en": "112 mango only", "hi": "केवल 112 आम"}, {"en": "45 litchi + 135 guava", "hi": "45 लीची + 135 अमरूद"}, {"en": "100 mango + 50 guava", "hi": "100 आम + 50 अमरूद"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Mixed model for 1 acre = 192 plants: 56 mango + 56 guava planted one after another at 5 × 5 m in the main plot, plus 80 timber/fodder plants on the border (about ₹3.4 lakh). 112 mango + 80 timber is the mango-only model; 45 litchi + 135 guava is the litchi model.", "hi": "1 एकड़ मिश्रित मॉडल = 192 पौधे: मुख्य प्लॉट में 5 × 5 मीटर पर एक के बाद एक 56 आम + 56 अमरूद, और किनारे पर 80 इमारती/चारा पौधे (लगभग ₹3.4 लाख)। 112 आम + 80 इमारती केवल आम का मॉडल है; 45 लीची + 135 अमरूद लीची मॉडल है।"}, "src": "BHGY Booklet p.16"}, {"type": "single", "q": {"en": "In every district, mixed fruit plants must be planted on at least how much of the total BHGY plantation area?", "hi": "हर जिले में BHGY के कुल बागवानी क्षेत्र के कम से कम कितने भाग में मिश्रित फलदार पौधे लगाने हैं?"}, "opts": [{"en": "10%", "hi": "10%"}, {"en": "25%", "hi": "25%"}, {"en": "50%", "hi": "50%"}, {"en": "100%", "hi": "100%"}, {"en": "There is no such rule", "hi": "ऐसा कोई नियम नहीं है"}], "ans": [2], "exp": {"en": "The 2024-25 guidelines ask each district to put at least 50% of its plantation area under mixed fruit plants, so that the beneficiary earns something all year. Mixed orchards should be done in a cluster approach so plants and materials reach on time.", "hi": "2024-25 मार्गदर्शिका के अनुसार हर जिले के कुल बागवानी क्षेत्र के कम से कम 50% में मिश्रित फलदार पौधे लगाने हैं, ताकि लाभुक को सालों भर आमदनी मिले। मिश्रित बागवानी क्लस्टर अप्रोच में हो ताकि पौधे और सामग्री समय पर पहुँचें।"}, "src": "BHGY Guidelines (N) 350, 19.03.2024, p.3"}, {"type": "single", "q": {"en": "Read the statements about mango varieties in BHGY:\n(i) Mainly Amrapali and Mallika mango are planted.\n(ii) If bigger varieties like Langra, Maldah or Dashehari are chosen, the mixed-plantation estimate should be used.\n(iii) Only mango can be planted under BHGY.\nWhich are correct?", "hi": "BHGY में आम की किस्मों के बारे में कथन पढ़ें:\n(i) मुख्य रूप से आम्रपाली और मल्लिका आम लगाए जाते हैं।\n(ii) लंगड़ा, मालदह या दशहरी जैसी बड़ी किस्में चुनने पर मिश्रित बागवानी का प्राक्कलन लेना है।\n(iii) BHGY में केवल आम ही लगाया जा सकता है।\nकौन-से कथन सही हैं?"}, "opts": [{"en": "Only (i)", "hi": "केवल (i)"}, {"en": "Only (ii)", "hi": "केवल (ii)"}, {"en": "Only (i) and (ii)", "hi": "केवल (i) और (ii)"}, {"en": "All of (i), (ii) and (iii)", "hi": "(i), (ii) और (iii) सभी"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [2], "exp": {"en": "(i) and (ii) are correct: Amrapali and Mallika are the main varieties, and large varieties need wider spacing, so the mixed estimate is used. (iii) is wrong: guava, lemon, litchi, ber, chiku, sharifa, pear, orange, jackfruit, drumstick, Arjun, Semialata and more can be planted.", "hi": "(i) और (ii) सही हैं: आम्रपाली और मल्लिका मुख्य किस्में हैं, और बड़ी किस्मों को अधिक दूरी चाहिए, इसलिए मिश्रित प्राक्कलन लिया जाता है। (iii) गलत है: अमरूद, नीम्बू, लीची, बैर, चीकू, शरीफा, नाशपाती, संतरा, कटहल, सहजन, अर्जुन, सेमियालता आदि भी लगाए जा सकते हैं।"}, "src": "BHGY Guidelines (N) 350, pp.2, 5"}, {"type": "single", "q": {"en": "Arjun plantation for tasar silk under BHGY can be done:", "hi": "तसर हेतु अर्जुन वृक्षारोपण BHGY में कैसे किया जा सकता है?"}, "opts": [{"en": "Only in a cluster of at least 15 acres; one beneficiary from 1 acre up to 2.47 acres (1 ha)", "hi": "केवल कम से कम 15 एकड़ के क्लस्टर में; एक लाभुक 1 एकड़ से 2.47 एकड़ (1 हेक्टेयर) तक"}, {"en": "Individually on as little as 10 decimal", "hi": "अकेले, केवल 10 डिसमिल पर भी"}, {"en": "Only on Gair Majarua land", "hi": "केवल गैर-मजरूआ जमीन पर"}, {"en": "Only in clusters of 100 acres or more", "hi": "केवल 100 एकड़ या उससे बड़े क्लस्टर में"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Arjun is planted only in a cluster of 15 acres or more, on the beneficiary's own land in their possession. One beneficiary can take at least 1 acre and at most 2.47 acres (1 hectare).", "hi": "अर्जुन का रोपण केवल 15 एकड़ या उससे बड़े क्लस्टर में, लाभुक की अपनी दखल वाली जमीन पर होगा। एक लाभुक कम से कम 1 एकड़ और अधिक से अधिक 2.47 एकड़ (1 हेक्टेयर) में लगा सकता है।"}, "src": "BHGY Guidelines (N) 350, p.9"}, {"type": "single", "q": {"en": "A good patch has no irrigation source within 100 metres. What should be done?", "hi": "एक अच्छे पैच के 100 मीटर के अंदर सिंचाई का साधन नहीं है। क्या करना चाहिए?"}, "opts": [{"en": "Plant fruit plants anyway and carry water by hand", "hi": "फिर भी फलदार पौधे लगा दें और हाथ से पानी ढोएं"}, {"en": "First create irrigation (e.g. a well) and land works like ECB/SCT, and plant fruit trees there the next year", "hi": "पहले सिंचाई (जैसे कुआँ) और ECB/SCT जैसे भूमि सुधार कार्य कराएं, और अगले वर्ष वहाँ फलदार पौधे लगाएं"}, {"en": "Plant only timber plants there this year", "hi": "इस वर्ष वहाँ केवल इमारती पौधे लगाएं"}, {"en": "Drop the whole village from the scheme", "hi": "पूरे गाँव को योजना से हटा दें"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [1], "exp": {"en": "The guidelines say: if there is no irrigation within 100 m, the Gram Sabha/Panchayat should first take up an irrigation work (like a well) and land works such as Earthen Contour Bund (ECB) or Staggered Contour Trench (SCT), and do the fruit orchard the next year. A site without year-round irrigation must not be selected.", "hi": "मार्गदर्शिका के अनुसार 100 मीटर के अंदर सिंचाई न हो तो ग्राम सभा/पंचायत पहले सिंचाई (जैसे कुआँ) और ECB (मिट्टी का कंटूर बांध) या SCT (स्टैगर्ड कंटूर ट्रेंच) जैसे कार्य कराए, और अगले वर्ष फलदार बागवानी करे। सालों भर सिंचाई न हो तो स्थल का चयन न करें।"}, "src": "BHGY Guidelines (N) 350, p.11"}, {"type": "multi", "q": {"en": "Which conditions must a beneficiary meet for an individual BHGY orchard? (Select all that apply)", "hi": "व्यक्तिगत BHGY बागवानी के लिए लाभुक को कौन-सी शर्तें पूरी करनी हैं? (सभी सही विकल्प चुनें)"}, "opts": [{"en": "Has a job card (or gets one before sanction)", "hi": "जॉब कार्ड हो (या स्वीकृति से पहले बन जाए)"}, {"en": "Has own savings bank account (or opens one before sanction)", "hi": "निजी बचत बैंक खाता हो (या स्वीकृति से पहले खुल जाए)"}, {"en": "Land is their own raiyati land, in their possession, with no dispute", "hi": "जमीन अपनी रैयती हो, उनके दखल में हो और कोई विवाद न हो"}, {"en": "Must own a tractor", "hi": "ट्रैक्टर होना जरूरी है"}, {"en": "Must be a government employee", "hi": "सरकारी कर्मचारी होना जरूरी है"}], "ans": [0, 1, 2], "exp": {"en": "The family should have a job card and a personal savings bank account before sanction, the land should be their own raiyati land in their possession without any dispute, they should depend mainly on farming and be able to give time to the orchard daily. No tractor or government job is needed.", "hi": "स्वीकृति से पहले जॉब कार्ड और निजी बचत बैंक खाता हो, जमीन अपनी रैयती, दखल में और बिना विवाद हो, आजीविका मुख्य रूप से खेती पर हो और बगान को रोज समय दे सकें। ट्रैक्टर या सरकारी नौकरी की जरूरत नहीं।"}, "src": "BHGY Guidelines (N) 350, pp.7–8"}, {"type": "single", "q": {"en": "The district-level Bagwani (Plantation) Salahkar Samiti must meet:", "hi": "जिला स्तरीय बागवानी सलाहकार समिति की बैठक कब होनी चाहिए?"}, "opts": [{"en": "At least once in three months, headed by the DC-cum-District Programme Coordinator", "hi": "कम से कम तीन महीने में एक बार, उपायुक्त-सह-जिला कार्यक्रम समन्वयक की अध्यक्षता में"}, {"en": "Every week, headed by the BDO", "hi": "हर सप्ताह, BDO की अध्यक्षता में"}, {"en": "Once a year, headed by the Mukhiya", "hi": "साल में एक बार, मुखिया की अध्यक्षता में"}, {"en": "Every month, headed by the Junior Engineer", "hi": "हर महीने, कनीय अभियंता की अध्यक्षता में"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "The district Bagwani Salahkar Samiti (letter (N) 455, 15.05.2020) meets at least once in 3 months (quarterly). It is headed by the DC-cum-DPC, with DFO, Agriculture and Horticulture officers, Soil Conservation officer, KVK expert, NABARD DDM, PO-MGNREGA / VB-G RAM G, JSLPS DPM, FPO and CSO members. The block committee also meets at least once in 3 months.", "hi": "जिला बागवानी सलाहकार समिति (पत्रांक (N) 455, 15.05.2020) की बैठक कम से कम तीन महीने में एक बार (तिमाही) होती है। अध्यक्ष उपायुक्त-सह-DPC; सदस्य वन प्रमण्डल पदाधिकारी, कृषि व उद्यान पदाधिकारी, मृदा संरक्षण पदाधिकारी, KVK विशेषज्ञ, NABARD DDM, PO-मनरेगा / VB-G RAM G, JSLPS DPM, FPO व CSO प्रतिनिधि। प्रखण्ड समिति की बैठक भी तीन महीने में कम से कम एक बार।"}, "src": "BHGY Guidelines (N) 350, pp.14–15"}, {"type": "single", "q": {"en": "Who heads the district Technical Inspection Team that checks nurseries before plants are bought?", "hi": "पौधे खरीदने से पहले नर्सरियों की जाँच करने वाले जिला तकनीकी जाँच दल की अध्यक्षता कौन करता है?"}, "opts": [{"en": "DDC-cum-Additional District Programme Coordinator", "hi": "उप विकास आयुक्त-सह-अतिरिक्त जिला कार्यक्रम समन्वयक"}, {"en": "Block Development Officer", "hi": "प्रखण्ड विकास पदाधिकारी"}, {"en": "Mukhiya", "hi": "मुखिया"}, {"en": "Bagwani Sakhi", "hi": "बागवानी सखी"}, {"en": "Nursery owner", "hi": "नर्सरी मालिक"}], "ans": [0], "exp": {"en": "The team is headed by the DDC-cum-ADPC. Members: District Agriculture/Horticulture Officer, KVK subject expert, PO-MGNREGA / VB-G RAM G, AE/JE, JSLPS District Livelihood Manager and two CSO members. It visits nurseries and reports; the final decision on supply is taken in a meeting chaired by the DC-cum-DPC.", "hi": "दल की अध्यक्षता उप विकास आयुक्त-सह-ADPC करते हैं। सदस्य: जिला कृषि/उद्यान पदाधिकारी, KVK विषय-वस्तु विशेषज्ञ, PO-मनरेगा / VB-G RAM G, सहायक/कनीय अभियंता, JSLPS जिला आजीविका प्रबंधक और दो CSO प्रतिनिधि। दल नर्सरी भ्रमण कर प्रतिवेदन देता है; अंतिम निर्णय उपायुक्त-सह-DPC की बैठक में होता है।"}, "src": "BHGY Guidelines (N) 350, pp.12–13"}, {"type": "single", "q": {"en": "About buying fruit plants for BHGY:\n(i) Plants are bought from NHB-registered nurseries of Jharkhand, selected by the district through tender.\n(ii) At least 50% of the plants to be supplied must be present in the nursery, so the team can check quality.\n(iii) The district names a nodal officer for each block (and the block for each panchayat) for timely lifting and planting.\nWhich are correct?", "hi": "BHGY के लिए फलदार पौधों की खरीद के बारे में:\n(i) पौधे झारखण्ड की NHB निबंधित नर्सरियों से लिए जाते हैं, जिनका चयन जिला निविदा से करता है।\n(ii) आपूर्ति किए जाने वाले कम से कम 50% पौधे नर्सरी में मौजूद होने चाहिए ताकि दल गुणवत्ता जाँच सके।\n(iii) समय पर उठाव और रोपण के लिए जिला हर प्रखण्ड के लिए (और प्रखण्ड हर पंचायत के लिए) नोडल पदाधिकारी नामित करता है।\nकौन-से कथन सही हैं?"}, "opts": [{"en": "Only (i)", "hi": "केवल (i)"}, {"en": "Only (ii)", "hi": "केवल (ii)"}, {"en": "Only (i) and (ii)", "hi": "केवल (i) और (ii)"}, {"en": "All of (i), (ii) and (iii)", "hi": "(i), (ii) और (iii) सभी"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [3], "exp": {"en": "All three are in the guidelines. Plants come from National Horticulture Board (NHB) registered nurseries chosen by district tender; at least 50% of the plants must be available in the nursery for transparent quality checking; and nodal officers are named at district and block level for timely lifting and planting.", "hi": "तीनों कथन मार्गदर्शिका में हैं। पौधे राष्ट्रीय बागवानी बोर्ड (NHB) से निबंधित, जिला निविदा से चुनी नर्सरियों से आते हैं; पारदर्शी जाँच हेतु कम से कम 50% पौधे नर्सरी में उपलब्ध हों; और समय पर उठाव व रोपण के लिए जिला व प्रखण्ड स्तर पर नोडल पदाधिकारी नामित होते हैं।"}, "src": "BHGY Guidelines (N) 350, pp.12–13"}, {"type": "single", "q": {"en": "Timber plants for BHGY should be bought on priority from:", "hi": "BHGY के लिए इमारती पौधे प्राथमिकता से कहाँ से खरीदे जाने चाहिए?"}, "opts": [{"en": "Didi Bagiya entrepreneurs", "hi": "दीदी बगिया उद्यमियों से"}, {"en": "Any roadside seller", "hi": "किसी भी सड़क किनारे विक्रेता से"}, {"en": "Private companies from outside the state", "hi": "राज्य के बाहर की निजी कंपनियों से"}, {"en": "Only from the Mukhiya's nursery", "hi": "केवल मुखिया की नर्सरी से"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Timber plants are bought first from Didi Bagiya (SHG women's nursery) entrepreneurs. If not available, from Forest Department / government nurseries / government agriculture institutions, and after that from NHB-registered Jharkhand nurseries selected by tender.", "hi": "इमारती पौधे प्राथमिकता से दीदी बगिया (SHG दीदियों की नर्सरी) उद्यमियों से लिए जाते हैं। उपलब्ध न हों तो वन विभाग/सरकारी नर्सरी/सरकारी कृषि संस्थानों से, और उसके बाद निविदा से चुनी NHB निबंधित झारखण्ड की नर्सरियों से।"}, "src": "BHGY Guidelines (N) 350, p.12"}, {"type": "multi", "q": {"en": "Which are signs of a good-quality grafted mango plant? (Select all that apply)", "hi": "अच्छे कलमी (ग्राफ्टेड) आम पौधे की पहचान क्या है? (सभी सही विकल्प चुनें)"}, "opts": [{"en": "The graft is at least one year old", "hi": "कलम कम से कम एक साल पुराना हो"}, {"en": "The graft joint is fully joined and no polythene is tied on it", "hi": "कलम वाला स्थान पूरी तरह जुड़ा हो और उस पर पॉलीथीन बंधा न हो"}, {"en": "New leaves have come at least three times after grafting", "hi": "कलम के बाद कम से कम तीन बार नई पत्तियाँ आई हों"}, {"en": "Polythene is still tightly tied at the graft joint", "hi": "कलम वाले स्थान पर पॉलीथीन अभी भी कसकर बंधा हो"}, {"en": "A few insects on leaves are fine", "hi": "पत्तियों पर थोड़े कीट हों तो भी ठीक है"}], "ans": [0, 1, 2], "exp": {"en": "A good plant: graft at least 1 year old; graft joint fully healed without polythene; at least 3 flushes of leaves after grafting (each flush leaves a ring mark on the stem); polytube at least 6\" × 7\" with plenty of undamaged roots; and no pest or disease.", "hi": "अच्छा पौधा: कलम कम से कम 1 साल पुराना; कलम का जोड़ पूरा जुड़ा और पॉलीथीन हटा हुआ; कलम के बाद कम से कम 3 बार नई पत्तियाँ (हर बार तने पर अंगूठी जैसा निशान); पॉलीट्यूब कम से कम 6\" × 7\" और जड़ें भरपूर व बिना क्षति; और कोई कीट या बीमारी न हो।"}, "src": "BHGY Booklet p.23"}, {"type": "multi", "q": {"en": "Plants have reached the village from the nursery. Which are the correct steps? (Select all that apply)", "hi": "नर्सरी से पौधे गाँव पहुँच गए हैं। सही कदम कौन-से हैं? (सभी सही विकल्प चुनें)"}, "opts": [{"en": "Unload them by holding the soil ball (thala), not the stem", "hi": "पौधों को थाला (मिट्टी का गोला) पकड़कर उतारें, तना पकड़कर नहीं"}, {"en": "Keep them in a shady, safe place and spray insecticide and fungicide (also on the mud-ball)", "hi": "छायादार व सुरक्षित स्थान पर रखें और कीटनाशक व फफूंदनाशक का छिड़काव करें (थाले पर भी)"}, {"en": "After about two days, carry them to the field in a basket/tray and plant", "hi": "लगभग दो दिन बाद टोकरी/ट्रे में खेत ले जाकर रोपाई करें"}, {"en": "Pull them off the vehicle by the stem to save time", "hi": "समय बचाने के लिए तना पकड़कर गाड़ी से खींच लें"}, {"en": "Keep them in open hot sun for a week before planting", "hi": "रोपाई से पहले एक सप्ताह तक खुली तेज धूप में रखें"}], "ans": [0, 1, 2], "exp": {"en": "Hold plants by the soil ball while unloading, rest them in shade, spray insecticide and fungicide (fungicide also on the mud-ball), and after two days take them in a basket or tray to the field, plant and water as needed.", "hi": "उतारते समय पौधों को थाला पकड़कर उतारें, छाया में रखें, कीटनाशक व फफूंदनाशक छिड़कें (फफूंदनाशक थाले पर भी), और दो दिन बाद टोकरी या ट्रे से खेत ले जाकर रोपाई करें और आवश्यकतानुसार सिंचाई दें।"}, "src": "BHGY Booklet p.24"}, {"type": "single", "q": {"en": "How should H-stakes be protected from termites?", "hi": "H-टेका (स्टेकिंग) को दीमक से कैसे बचाएं?"}, "opts": [{"en": "Paint them with coal tar or burnt mobil (used engine oil)", "hi": "कोलतार या जले हुए मोबिल से रंग दें"}, {"en": "Wrap them in polythene", "hi": "पॉलीथीन में लपेट दें"}, {"en": "Use thin, weak sticks so they are replaced often", "hi": "पतली कमजोर लकड़ी लगाएं ताकि बार-बार बदली जाए"}, {"en": "Soak them in urea solution", "hi": "यूरिया के घोल में भिगो दें"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Use big, strong stakes so they need not be changed as the plant grows, and paint them with coal tar or burnt mobil to protect them from termites. The H-stake is tied above the graft and should be fixed by July.", "hi": "बड़ा और मजबूत टेका लगाएं ताकि पौधा बढ़ने पर बार-बार न बदलना पड़े, और दीमक से बचाने के लिए कोलतार/जले मोबिल से रंग दें। H-टेका कलम के ऊपर बांधा जाता है और जुलाई तक लग जाना चाहिए।"}, "src": "BHGY Booklet p.32; BHGY Guidelines timeline"}, {"type": "single", "q": {"en": "BHGY work norms (person-days) under MGNREGA / VB-G RAM G:\n(i) 1 person-day for irrigating every 80 plants.\n(ii) 1 person-day for fixing H-stakes on every 400 mango plants.\n(iii) 1 person-day for spraying every 100 plants.\nWhich are correct?", "hi": "मनरेगा / VB-G RAM G अंतर्गत BHGY कार्य के मानक (मानव-दिवस):\n(i) हर 80 पौधों की सिंचाई पर 1 मानव-दिवस।\n(ii) हर 400 आम पौधों में H-टेका लगाने पर 1 मानव-दिवस।\n(iii) हर 100 पौधों में दवा छिड़काव पर 1 मानव-दिवस।\nकौन-से कथन सही हैं?"}, "opts": [{"en": "Only (i)", "hi": "केवल (i)"}, {"en": "Only (i) and (ii)", "hi": "केवल (i) और (ii)"}, {"en": "Only (i) and (iii)", "hi": "केवल (i) और (iii)"}, {"en": "All of (i), (ii) and (iii)", "hi": "(i), (ii) और (iii) सभी"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [2], "exp": {"en": "(i) and (iii) are correct. (ii) is wrong: H-stake preparation and fixing is 1 person-day for every 40 mango plants. Other norms: weeding-manuring-basin 1 person-day per 25 plants; fencing 1 person-day per 20 ft plus ₹8 per ft for material.", "hi": "(i) और (iii) सही हैं। (ii) गलत है: H-टेका तैयार करने व लगाने के लिए हर 40 आम पौधों पर 1 मानव-दिवस है। अन्य मानक: निकाई-गुड़ाई-खाद-बेसिन के लिए 25 पौधों पर 1 मानव-दिवस; घेरान 20 फीट पर 1 मानव-दिवस और सामग्री ₹8 प्रति फीट।"}, "src": "BHGY Booklet p.54"}, {"type": "single", "q": {"en": "In the second year, repair of the orchard fencing is allowed up to:", "hi": "दूसरे वर्ष में बगान के घेरान की मरम्मत कितनी तक कराई जा सकती है?"}, "opts": [{"en": "25% of the total fencing", "hi": "कुल घेरान का अधिकतम 25%"}, {"en": "50% of the total fencing", "hi": "कुल घेरान का 50%"}, {"en": "100% — full new fencing every year", "hi": "100% — हर साल पूरा नया घेरान"}, {"en": "No repair is allowed", "hi": "कोई मरम्मत नहीं"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "In the first year a 5 ft high live fence is made around the orchard; in the second year repair of up to 25% of the total fencing is allowed.", "hi": "पहले वर्ष बगान के चारों ओर 5 फीट ऊँचा जिन्दा घेरान बनता है; दूसरे वर्ष कुल घेरान के अधिकतम 25% तक की मरम्मत का प्रावधान है।"}, "src": "BHGY Booklet p.54"}, {"type": "single", "q": {"en": "As per the Bagwani Sakhi policy, how is Bagwani Sakhi training organised?", "hi": "बागवानी सखी प्रोत्साहन नीति के अनुसार बागवानी सखी का प्रशिक्षण कैसे होता है?"}, "opts": [{"en": "5 modules in phases; Module 1 is a 3-day residential training in April–May", "hi": "चरणबद्ध 5 मॉड्यूल; मॉड्यूल 1 अप्रैल–मई में 3 दिवसीय आवासीय प्रशिक्षण"}, {"en": "One 1-day meeting only", "hi": "केवल एक 1 दिवसीय बैठक"}, {"en": "10 online modules, no field visit", "hi": "10 ऑनलाइन मॉड्यूल, कोई फील्ड भ्रमण नहीं"}, {"en": "No training — only experience counts", "hi": "कोई प्रशिक्षण नहीं — केवल अनुभव"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Training is phased in 5 residential modules: Module 1 (April–May, 3 days: scheme provisions, site and soil, layout, pits, fencing, CPT, jalkund, registers, mobile app); Module 2 (June–August, 3 days: plant quality, planting, diseases, kharif crops); Module 3 (Sept–Nov, 2 days: pruning, canopy, irrigation, flowering, harvest, rabi crops); Module 4 (Dec–Feb, 2 days: producer groups and marketing); Module 5 (2-day refresher).", "hi": "प्रशिक्षण 5 आवासीय मॉड्यूल में चरणबद्ध होता है: मॉड्यूल 1 (अप्रैल–मई, 3 दिन: योजना प्रावधान, स्थल व मिट्टी, ले-आउट, गड्ढा, घेरान, CPT, जलकुंड, पंजी, मोबाइल ऐप); मॉड्यूल 2 (जून–अगस्त, 3 दिन: पौधों की गुणवत्ता, रोपण, बीमारी, खरीफ फसल); मॉड्यूल 3 (सितंबर–नवंबर, 2 दिन: कटाई-छँटाई, कैनोपी, सिंचाई, फूल-फल, तुड़ाई, रबी फसल); मॉड्यूल 4 (दिसंबर–फरवरी, 2 दिन: उत्पादक संघ व बिक्री); मॉड्यूल 5 (2 दिन रिफ्रेशर)।"}, "src": "Bagwani Sakhi Protsahan Niti (N) 85, section 4.2"}, {"type": "single", "q": {"en": "As per the 2024 Bagwani Sakhi policy:\n(i) Selection, training and payment of the Sakhi is done by JSLPS as per DAY-NRLM guidelines.\n(ii) Her name must be registered in the JSLPS MIS; otherwise she cannot be paid as a community cadre.\n(iii) The Sakhi is paid by the nursery owner.\nWhich are correct?", "hi": "2024 की बागवानी सखी नीति के अनुसार:\n(i) सखी का चयन, प्रशिक्षण और भुगतान JSLPS द्वारा DAY-NRLM मार्गदर्शिका अनुसार होता है।\n(ii) उसका नाम JSLPS के MIS में पंजीकृत होना जरूरी है; नहीं तो सामुदायिक कैडर के रूप में भुगतान नहीं होगा।\n(iii) सखी को भुगतान नर्सरी मालिक करता है।\nकौन-से कथन सही हैं?"}, "opts": [{"en": "Only (i)", "hi": "केवल (i)"}, {"en": "Only (iii)", "hi": "केवल (iii)"}, {"en": "Only (i) and (ii)", "hi": "केवल (i) और (ii)"}, {"en": "All of (i), (ii) and (iii)", "hi": "(i), (ii) और (iii) सभी"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [2], "exp": {"en": "(i) and (ii) are correct. Selected Sakhis are listed with the state office and registered in the JSLPS MIS; a Sakhi not shown on the portal is not treated as contracted and gets no cadre payment. She submits a monthly payment form and is paid for work done. (iii) is wrong.", "hi": "(i) और (ii) सही हैं। चयनित सखियों की सूची राज्य कार्यालय में जमा होकर JSLPS के MIS में पंजीकरण होता है; पोर्टल पर नाम न दिखे तो उसे अनुबंधित नहीं माना जाएगा और कैडर भुगतान नहीं होगा। वह हर माह भुगतान प्रपत्र देती है और कार्य के अनुसार भुगतान पाती है। (iii) गलत है।"}, "src": "Bagwani Sakhi Protsahan Niti (N) 85, sections 4.3–4.4"}, {"type": "multi", "q": {"en": "Which statements about the one-day 'Aam Utsav-cum-Bagwani Mela' are correct? (Select all that apply)", "hi": "एक दिवसीय 'आम उत्सव-सह-बागवानी मेला' के बारे में कौन-से कथन सही हैं? (सभी सही विकल्प चुनें)"}, "opts": [{"en": "It is held at cluster, block and district level", "hi": "यह संकुल, प्रखण्ड और जिला स्तर पर होता है"}, {"en": "Naturally (organically) ripened fruits are given special importance", "hi": "जैविक रूप से पकाए गए फलों को विशेष महत्व दिया जाता है"}, {"en": "Successful beneficiaries are invited to share their success stories", "hi": "सफल लाभुकों को अपनी सफलता की कहानी बताने के लिए बुलाया जाता है"}, {"en": "Fruits ripened with harmful chemicals are promoted", "hi": "हानिकारक रसायन से पकाए गए फलों को बढ़ावा दिया जाता है"}, {"en": "It is held only once in 5 years in the state capital", "hi": "यह केवल 5 साल में एक बार राजधानी में होता है"}], "ans": [0, 1, 2], "exp": {"en": "The mela is a one-day event at cluster, block and district level (June–July in the calendar). It popularises BHGY and its fruits, highlights naturally ripened fruit and warns about fruit ripened with harmful chemicals. Good farmers share success stories; it is publicised at least a week before and documented.", "hi": "मेला संकुल, प्रखण्ड और जिला स्तर पर एक दिवसीय आयोजन है (कैलेंडर में जून–जुलाई)। इससे BHGY व उसके फलों का प्रचार होता है, जैविक रूप से पके फलों को महत्व और रसायन से पकाए फलों के दुष्प्रभाव बताए जाते हैं। सफल किसान अपनी कहानी साझा करते हैं; कम से कम एक सप्ताह पहले प्रचार और दस्तावेजीकरण होता है।"}, "src": "BHGY Guidelines (N) 350, p.21"}, {"type": "single", "q": {"en": "All costs of BHGY trainings and exposure visits for MGNREGA / VB-G RAM G, JSLPS and CSO staff are met from:", "hi": "मनरेगा / VB-G RAM G, JSLPS और CSO कर्मियों के BHGY प्रशिक्षण एवं स्थल भ्रमण का सारा खर्च कहाँ से होता है?"}, "opts": [{"en": "The administrative head of MGNREGA / VB-G RAM G", "hi": "मनरेगा / VB-G RAM G के प्रशासनिक मद से"}, {"en": "Participants pay themselves", "hi": "प्रतिभागी स्वयं देते हैं"}, {"en": "The nursery supplier", "hi": "नर्सरी आपूर्तिकर्ता"}, {"en": "The beneficiary's wage", "hi": "लाभुक की मजदूरी से"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Training and exposure-visit expenses are met from the MGNREGA / VB-G RAM G administrative head, arranged by the district and block. KVK, JSLPS, Agriculture/Animal Husbandry department and CSO experts can be used as resource persons, and each district keeps a list of trainers.", "hi": "प्रशिक्षण और स्थल भ्रमण का खर्च मनरेगा / VB-G RAM G के प्रशासनिक मद से होता है, जिसकी व्यवस्था जिला और प्रखण्ड करते हैं। KVK, JSLPS, कृषि/पशुपालन विभाग और CSO विशेषज्ञ संसाधन व्यक्ति हो सकते हैं और जिला प्रशिक्षकों की सूची बनाता है।"}, "src": "BHGY Guidelines (N) 350, p.20"}, {"type": "single", "q": {"en": "On a Kusum tree, Kusmi lac normally multiplies how much in one 6-month crop?", "hi": "कुसुम वृक्ष पर कुसमी लाख की एक 6 माह की फसल में सामान्यतः कितनी गुना उपज होती है?"}, "opts": [{"en": "About 7–8 times (1 kg brood lac gives 7–8 kg)", "hi": "लगभग 7–8 गुना (1 किलो बीहन लाख से 7–8 किलो)"}, {"en": "Same quantity (1 kg gives 1 kg)", "hi": "उतनी ही (1 किलो से 1 किलो)"}, {"en": "About 50 times", "hi": "लगभग 50 गुना"}, {"en": "Lac cannot be grown on Kusum", "hi": "कुसुम पर लाख नहीं होती"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "On Kusum, the Kusmi lac insect gives about 7–8 times in a 6-month crop: 1 kg brood lac gives 7–8 kg. A big tree needs 4–6 kg brood and gives 30–45 kg brood after 6 months. Kusum gives lac about 6 years after planting; trees are pruned about 18 months before inoculation (12 months the first time).", "hi": "कुसुम पर कुसमी लाख कीट 6 माह की फसल में लगभग 7–8 गुना देता है: 1 किलो बीहन से 7–8 किलो। एक बड़े वृक्ष पर 4–6 किलो बीहन लगता है और 6 माह बाद 30–45 किलो बीहन मिलता है। रोपण के लगभग 6 वर्ष बाद कुसुम पर लाख होती है; कीट-संचारण से लगभग 18 माह पहले (पहली बार 12 माह) कटाई-छँटाई करते हैं।"}, "src": "Kusum & Semialata letter (N) 1075, pp.3–4"}, {"type": "single", "q": {"en": "For the best income from a litchi orchard, the Litchi SoP advises:", "hi": "लीची बागान से अधिकतम लाभ के लिए लीची SoP क्या सलाह देता है?"}, "opts": [{"en": "Plant a mix of early (e.g. Shahi) and late (e.g. China) litchi varieties", "hi": "अगेती (जैसे शाही) और पछेती (जैसे चाइना) किस्मों का मिश्रण लगाएं"}, {"en": "Plant only one variety", "hi": "केवल एक ही किस्म लगाएं"}, {"en": "Do not plant guava with litchi", "hi": "लीची के साथ अमरूद न लगाएं"}, {"en": "Plant litchi without any irrigation source", "hi": "बिना सिंचाई साधन के लीची लगाएं"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Shahi is early (15–30 May, fragrant, high yield), Swarnmadhu is mid (1–10 June, big fruit, small seed) and China/Purbi is late (10–15 June, bears in alternate years). Mixing early and late varieties spreads harvest and gives maximum benefit. Guava/ber/sharifa are planted with litchi, and year-round irrigation is required.", "hi": "शाही अगेती (15–30 मई, सुगंधित, अधिक उपज), स्वर्णमधु मध्यम (1–10 जून, फल बड़ा, बीज छोटा) और चाइना/पूर्वी पछेती (10–15 जून, एक वर्ष के अंतराल पर फल)। अगेती और पछेती किस्मों के मिश्रण से तुड़ाई फैलती है और अधिकतम लाभ मिलता है। लीची के साथ अमरूद/बेर/शरीफा लगते हैं और सालों भर सिंचाई जरूरी है।"}, "src": "Litchi Mixed Plantation SoP (N) 881, pp.5, 10"}, {"type": "single", "q": {"en": "Chlorothalonil 75% WP (trade name Kavach), used in BHGY orchards, is a:", "hi": "बागवानी में प्रयोग होने वाला क्लोरोथलोनिल 75% WP (व्यापारिक नाम कवच) क्या है?"}, "opts": [{"en": "Fungicide", "hi": "फफूंदनाशक"}, {"en": "Insecticide", "hi": "कीटनाशक"}, {"en": "Termiticide", "hi": "दीमकनाशक"}, {"en": "Fertiliser", "hi": "उर्वरक"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Chlorothalonil 75% WP (Kavach) is a fungicide, used at 1.5 g per litre of water, twice a year, mainly against anthracnose. Other fungicides in BHGY: copper oxychloride (2 g per plant, twice a year) and blue copper.", "hi": "क्लोरोथलोनिल 75% WP (कवच) फफूंदनाशक है, 1.5 ग्राम प्रति लीटर पानी में, साल में दो बार, मुख्यतः एन्थ्रेक्नोज के लिए। BHGY के अन्य फफूंदनाशक: कॉपर ऑक्सीक्लोराइड (2 ग्राम प्रति पौधा, साल में दो बार) और ब्लू कॉपर।"}, "src": "BHGY Booklet p.22 (dose table), p.46"}, {"type": "multi", "q": {"en": "Which of these are INSECTICIDES recommended in the BHGY booklet? (Select all that apply)", "hi": "BHGY पुस्तिका में बताए गए इनमें से कौन-से कीटनाशक (INSECTICIDE) हैं? (सभी सही विकल्प चुनें)"}, "opts": [{"en": "Lambda-cyhalothrin 5% EC (Karate)", "hi": "लैम्ब्डा साइहलोथ्रिन 5% EC (कराटे)"}, {"en": "Quinalphos", "hi": "क्विनालफॉस"}, {"en": "Imidacloprid", "hi": "इमिडाक्लोप्रिड"}, {"en": "Copper oxychloride", "hi": "कॉपर ऑक्सीक्लोराइड"}, {"en": "Chlorothalonil", "hi": "क्लोरोथलोनिल"}], "ans": [0, 1, 2], "exp": {"en": "Insecticides: Lambda-cyhalothrin 5% EC (1 ml/L) and Quinalphos (2 ml/L) against mango stem borer; Imidacloprid or Dimethoate on new leaves against leaf gall midge; Ektara (thiamethoxam) and neem oil against thrips. Copper oxychloride and Chlorothalonil are fungicides.", "hi": "कीटनाशक: लैम्ब्डा साइहलोथ्रिन 5% EC (1 मिली/ली) और क्विनालफॉस (2 मिली/ली) आम के तना छेदक पर; इमिडाक्लोप्रिड या डाइमेथोएट नई पत्तियों पर लीफ गॉल मिज के लिए; एक्टारा (थायमेथोक्साम) व नीम तेल थ्रिप्स पर। कॉपर ऑक्सीक्लोराइड और क्लोरोथलोनिल फफूंदनाशक हैं।"}, "src": "BHGY Booklet pp.22, 36, 38, 43"}, {"type": "multi", "q": {"en": "Which of these are used for TERMITE (deemak) control in BHGY orchards? (Select all that apply)", "hi": "BHGY बागान में दीमक नियंत्रण के लिए इनमें से किनका प्रयोग होता है? (सभी सही विकल्प चुनें)"}, "opts": [{"en": "Bifenthrin (Biflex TC)", "hi": "बाइफेन्थ्रिन (बाइफ्लेक्स TC)"}, {"en": "Chlorpyriphos 20 EC", "hi": "क्लोरपायरीफॉस 20 EC"}, {"en": "Neem or karanj cake (khalli)", "hi": "नीम या करंज की खल्ली"}, {"en": "Urea", "hi": "यूरिया"}, {"en": "Starch 2% spray", "hi": "स्टार्च 2% का छिड़काव"}], "ans": [0, 1, 2], "exp": {"en": "For termites: spray Bifenthrin (Biflex TC, 2–3 ml/L) on pit walls; pour Chlorpyriphos 20 EC (2 ml/L) or Biflex TC into the termite mound to kill the queen; apply neem/karanj cake (250 kg/ha) and irrigate; use only fully decomposed FYM; after destroying the mound, paint lime + neem oil on the stem. Urea is a fertiliser; starch spray is for sooty mould.", "hi": "दीमक के लिए: गड्ढे की दीवारों पर बाइफेन्थ्रिन (बाइफ्लेक्स TC, 2–3 मिली/ली) का छिड़काव; रानी दीमक नष्ट करने के लिए बामी में क्लोरपायरीफॉस 20 EC (2 मिली/ली) या बाइफ्लेक्स TC डालें; नीम/करंज खल्ली (250 किग्रा/हे.) डालकर सिंचाई; केवल पूरी सड़ी गोबर खाद; बामी नष्ट करने के बाद तने पर चूना + नीम तेल का लेप। यूरिया उर्वरक है; स्टार्च छिड़काव काली असिता के लिए है।"}, "src": "BHGY Booklet pp.21, 39–41"}, {"type": "single", "q": {"en": "Trichoderma, mixed with compost and applied at planting (10 g per plant), is a:", "hi": "रोपाई के समय खाद में मिलाकर डाला जाने वाला ट्राईकोडर्मा (10 ग्राम प्रति पौधा) क्या है?"}, "opts": [{"en": "Biological fungicide — a friendly fungus that protects roots from soil-borne fungal disease", "hi": "जैविक फफूंदनाशक — मित्र फफूंद जो जड़ों को मिट्टी जनित फफूंद रोग से बचाता है"}, {"en": "Chemical insecticide", "hi": "रासायनिक कीटनाशक"}, {"en": "Weedicide", "hi": "खरपतवारनाशक"}, {"en": "Plant growth hormone", "hi": "पौधों का वृद्धि हार्मोन"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Trichoderma is a bio-fungicide. Mix 1 kg in 100 kg compost/FYM, keep the heap in shade under a wet jute bag, turn it after 7 days; it is ready in about 15 days. Apply 2–3 days before planting, and do not use chemical fungicide in the root soil afterwards.", "hi": "ट्राईकोडर्मा जैविक फफूंदनाशक है। 100 किलो खाद में 1 किलो मिलाएं, ढेर को छाया में भीगे बोरे से ढकें, 7 दिन बाद उलट-पलट करें; लगभग 15 दिन में तैयार। रोपाई से 2–3 दिन पहले डालें और उसके बाद जड़ की मिट्टी में रासायनिक फफूंदनाशक न डालें।"}, "src": "BHGY Booklet pp.21–22"}, {"type": "single", "q": {"en": "The bio-insecticide Azadirachtin 3000 ppm (used at 2 ml per litre) is made from:", "hi": "जैविक कीटनाशक एज़ाडिरेक्टिन 3000 PPM (2 मिली प्रति लीटर) किससे बनता है?"}, "opts": [{"en": "Neem", "hi": "नीम"}, {"en": "Tobacco", "hi": "तम्बाकू"}, {"en": "Copper", "hi": "तांबा (कॉपर)"}, {"en": "Sulphur", "hi": "गंधक (सल्फर)"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Azadirachtin is the active part of neem oil. Neem oil (Azadirachtin 3000 ppm) is sprayed at 2 ml per litre, twice a year, and against thrips, hairy caterpillars and other leaf-eating insects.", "hi": "एज़ाडिरेक्टिन नीम तेल का सक्रिय तत्व है। नीम तेल (एज़ाडिरेक्टिन 3000 PPM) 2 मिली प्रति लीटर, साल में दो बार, और थ्रिप्स, रोएँदार इल्ली व पत्ती खाने वाले कीटों पर छिड़का जाता है।"}, "src": "BHGY Booklet pp.22, 37, 43"}, {"type": "single", "q": {"en": "Fipronil 0.3% GR is put in the pit at planting (10 g per plant). Why?", "hi": "रोपाई के समय गड्ढे में फिप्रोनिल 0.3% GR (10 ग्राम प्रति पौधा) क्यों डाला जाता है?"}, "opts": [{"en": "To protect roots from soil insects like termites", "hi": "जड़ों को दीमक जैसे मिट्टी के कीटों से बचाने के लिए"}, {"en": "To increase flowering", "hi": "फूल बढ़ाने के लिए"}, {"en": "To control anthracnose (a fungus)", "hi": "एन्थ्रेक्नोज (फफूंद) रोकने के लिए"}, {"en": "As the main fertiliser", "hi": "मुख्य उर्वरक के रूप में"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Fipronil 0.3% GR is a granular soil insecticide. 10 g per pit at planting protects the young roots from termites and other soil insects. It is not a fungicide or fertiliser.", "hi": "फिप्रोनिल 0.3% GR दानेदार मिट्टी कीटनाशक है। रोपाई के समय प्रति गड्ढा 10 ग्राम डालने से छोटी जड़ें दीमक और मिट्टी के अन्य कीटों से बचती हैं। यह फफूंदनाशक या उर्वरक नहीं है।"}, "src": "BHGY Booklet pp.22, 27"}, {"type": "single", "q": {"en": "In the Jethwi (summer) lac crop, Indoxacarb 0.007% and Carbendazim 0.05% are sprayed 28–30 days after tying brood lac. Which is correct?", "hi": "जेठवी (ग्रीष्मकालीन) लाख फसल में बीहन चढ़ाने के 28–30 दिन पर इन्डोक्साकार्ब 0.007% और कारबेन्डाजिम 0.05% छिड़का जाता है। सही क्या है?"}, "opts": [{"en": "Indoxacarb is an insecticide (against enemy insects like Chrysopa) and Carbendazim is a fungicide", "hi": "इन्डोक्साकार्ब कीटनाशक है (क्राइसोपा जैसे शत्रु कीट के लिए) और कारबेन्डाजिम फफूंदनाशक है"}, {"en": "Both are fertilisers", "hi": "दोनों उर्वरक हैं"}, {"en": "Both are fungicides", "hi": "दोनों फफूंदनाशक हैं"}, {"en": "Both are weedicides", "hi": "दोनों खरपतवारनाशक हैं"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [0], "exp": {"en": "Indoxacarb is an insecticide against Chrysopa and other enemy insects of the lac insect; Carbendazim is a fungicide. If Chrysopa attacks, a second spray is given at 60–62 days. In the Aghani crop, Ethofenprox (Bombard 10 EC) with Carbendazim is used.", "hi": "इन्डोक्साकार्ब लाख कीट के शत्रु कीट क्राइसोपा आदि के लिए कीटनाशक है; कारबेन्डाजिम फफूंदनाशक है। क्राइसोपा का आक्रमण हो तो 60–62 दिन पर दूसरा छिड़काव। अगहनी फसल में इथोफेनप्रॉक्स (बम्बार्ड 10 EC) के साथ कारबेन्डाजिम दिया जाता है।"}, "src": "Kusum & Semialata letter (N) 1075, pp.4–5"}, {"type": "single", "q": {"en": "Mango leaves and fruits show a black velvety layer (sooty mould). Which fungicide is sprayed as the main treatment?", "hi": "आम की पत्तियों व फलों पर काली मखमली परत (काली असिता / सूटी मोल्ड) दिख रही है। मुख्य उपचार के रूप में कौन-सा फफूंदनाशक छिड़कें?"}, "opts": [{"en": "Copper oxychloride", "hi": "कॉपर ऑक्सीक्लोराइड"}, {"en": "Chlorothalonil", "hi": "क्लोरोथलोनिल"}, {"en": "Carbendazim", "hi": "कारबेन्डाजिम"}, {"en": "Mancozeb", "hi": "मैन्कोजेब"}, {"en": "None of these — control the sucking insect (mealybug) and spray 2% starch", "hi": "इनमें से कोई नहीं — चूसक कीट (मधुआ/गुजिया) का नियंत्रण करें और 2% स्टार्च छिड़कें"}], "ans": [4], "exp": {"en": "Sooty mould grows on the sticky honeydew of sucking insects such as mealybug (gujiya). The booklet's treatment is to control the insect with a suitable insecticide and spray 2% starch, which dries and peels off the black layer.", "hi": "काली असिता चूसक कीटों जैसे मधुआ (गुजिया) के चिपचिपे मधुरस पर उगती है। पुस्तिका के अनुसार उचित कीटनाशक से कीट का नियंत्रण करें और 2% स्टार्च का छिड़काव करें, जो सूखकर काली परत को उतार देता है।"}, "src": "BHGY Booklet p.47"}, {"type": "single", "q": {"en": "About Mango Gummosis (gum oozing from the stem):\n(i) It is an insect pest that is controlled with urea.\n(ii) Remove/clean the diseased bark and apply copper oxychloride or cow-dung paste.\n(iii) Apply copper sulphate 500 g per tree in the soil around the trunk.\nWhich are correct?", "hi": "आम गमोसिस (तने से गोंद निकलना) के बारे में:\n(i) यह एक कीट है जिसका नियंत्रण यूरिया से होता है।\n(ii) रोगग्रस्त छाल हटाकर/साफ करके कॉपर ऑक्सीक्लोराइड या गाय के गोबर का लेप लगाएं।\n(iii) तने के आसपास की मिट्टी में 500 ग्राम कॉपर सल्फेट प्रति पेड़ डालें।\nकौन-से कथन सही हैं?"}, "opts": [{"en": "Only (i)", "hi": "केवल (i)"}, {"en": "Only (ii)", "hi": "केवल (ii)"}, {"en": "Only (ii) and (iii)", "hi": "केवल (ii) और (iii)"}, {"en": "All of (i), (ii) and (iii)", "hi": "(i), (ii) और (iii) सभी"}, {"en": "None of these", "hi": "इनमें से कोई नहीं"}], "ans": [2], "exp": {"en": "(ii) and (iii) are the booklet's management steps. (i) is wrong: gummosis is a disease (gum drops on stem and cracked bark, bark rots and the tree can dry), not an insect, and urea does not control it. Copper oxychloride and copper sulphate are copper-based chemicals against fungal disease.", "hi": "(ii) और (iii) पुस्तिका में बताए प्रबंधन हैं। (i) गलत है: गमोसिस एक रोग है (तने व फटी छाल पर गोंद, छाल सड़ती है और पेड़ सूख सकता है), कीट नहीं, और यूरिया से नियंत्रण नहीं होता। कॉपर ऑक्सीक्लोराइड और कॉपर सल्फेट फफूंद रोग के विरुद्ध तांबा आधारित रसायन हैं।"}, "src": "BHGY Booklet p.49"}];

function doGet() {
  return HtmlService.createHtmlOutputFromFile("Index")
    .setTitle("BHGY Plantation Post-Test")
    .addMetaTag("viewport", "width=device-width, initial-scale=1")
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/** Lets a copy of the test hosted elsewhere (e.g. GitHub Pages) submit results to this script. */
function doPost(e) {
  var r;
  try { r = submitResult(JSON.parse(e.postData.contents)); }
  catch (err) { r = { ok: false, error: String(err && err.message || err) }; }
  return ContentService.createTextOutput(JSON.stringify(r)).setMimeType(ContentService.MimeType.JSON);
}

function submitResult(p) {
  try {
    if (!p || !p.info || !p.info.email) throw new Error("Missing participant email");
    var email = String(p.info.email).trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) throw new Error("Invalid email");

    var r = scoreAnswers_(p.answers || [], paper_(p).order);
    var lock = LockService.getScriptLock();          // many participants may submit at the same moment
    lock.waitLock(30000);
    try { logResult_(p, r); } finally { lock.releaseLock(); }

    var subject = "BHGY Post-Test result: " + r.correct + "/" + r.total + " (" + (r.passed ? "Passed" : "Not passed") + ") – " + p.info.name;
    var opts = { htmlBody: buildEmailHtml_(p, r), name: "BHGY Post-Test" };
    if (TRAINER_EMAIL) opts.bcc = TRAINER_EMAIL;
    MailApp.sendEmail(email, subject, buildEmailText_(p, r), opts);
    return { ok: true, score: r.correct };
  } catch (e) {
    return { ok: false, error: String(e && e.message || e) };
  }
}

function scoreAnswers_(answers, order) {
  var c = 0, w = 0, u = 0, per = [];
  for (var x = 0; x < QUESTIONS.length; x++) per.push("");        // "" = not in this participant's paper
  for (var d = 0; d < order.length; d++) {
    var i = order[d];
    var a = (answers[i] || []).slice().sort().join(",");
    var k = QUESTIONS[i].ans.slice().sort().join(",");
    if (!a) { u++; per[i] = "skip"; } else if (a === k) { c++; per[i] = "ok"; } else { w++; per[i] = "bad"; }
  }
  var n = order.length, passMark = Math.ceil(n * PASS_PERCENT / 100);
  return { correct: c, wrong: w, unanswered: u, total: n,
           pct: n ? Math.round(c * 100 / n) : 0, passMark: passMark, passed: c >= passMark, per: per };
}

function logResult_(p, r) {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty("SHEET_ID"), ss;
  if (id) { try { ss = SpreadsheetApp.openById(id); } catch (e) { ss = null; } }
  if (!ss) { ss = SpreadsheetApp.create("BHGY Post-Test Results"); props.setProperty("SHEET_ID", ss.getId()); }
  var sh = ss.getSheetByName(SHEET_NAME) || ss.insertSheet(SHEET_NAME);
  if (sh.getLastRow() === 0) {
    var head = ["Submitted at", "Name", "Email", "Designation", "District/Block", "Correct", "Wrong", "Unanswered", "Score %", "Result", "Time taken (min)", "Auto-submitted (time up)"];
    for (var i = 0; i < QUESTIONS.length; i++) head.push("Master Q" + (i + 1));
    head.push("Paper order (master Q nos.)");
    sh.appendRow(head); sh.setFrozenRows(1);
  }
  var mins = p.submittedAt ? Math.round((p.submittedAt - p.startedAt) / 600) / 100 : "";
  var row = [new Date(), p.info.name, p.info.email, p.info.role || "", p.info.place || "", r.correct, r.wrong, r.unanswered, r.pct,
             r.passed ? "PASS" : "FAIL", mins, p.timeUp ? "Yes" : "No"];
  for (var j = 0; j < QUESTIONS.length; j++) {
    var mine = (p.answers[j] || []).map(function (k) { return LETTERS[k]; }).join("");
    row.push(r.per[j] === "" ? "" : (mine || "-") + (r.per[j] === "ok" ? " ✔" : r.per[j] === "bad" ? " ✘" : ""));
  }
  row.push(paper_(p).order.map(function (i) { return i + 1; }).join(","));
  sh.appendRow(row);
}

/** The participant's own paper: question order and option order they saw (falls back to master order). */
function paper_(p) {
  var n = QUESTIONS.length, order = p.order, opt = p.opt, i;
  var ok = order && order.length > 0 && order.length <= n && opt && opt.length === n &&
           order.every(function (x) { return typeof x === "number" && x >= 0 && x < n; });
  if (!ok) {
    order = []; opt = [];
    for (i = 0; i < n; i++) opt.push(QUESTIONS[i].opts.map(function (_, k) { return k; }));
    for (i = 0; i < Math.min(PAPER_SIZE, n); i++) order.push(i);
  }
  return { order: order, opt: opt };
}

function esc_(s) { return String(s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }

function buildEmailHtml_(p, r) {
  var ok = "#23804A", bad = "#B8382A", grey = "#6F7A73";
  var h = [];
  h.push('<div style="font-family:Arial,Helvetica,sans-serif;max-width:720px;color:#15231A;line-height:1.5">');
  h.push('<div style="background:#1E6A42;color:#fff;padding:18px 20px;border-radius:12px 12px 0 0">');
  h.push('<div style="font-size:13px;opacity:.85">Birsa Harit Gram Yojana · बिरसा हरित ग्राम योजना</div>');
  h.push('<div style="font-size:22px;font-weight:bold">Plantation Post-Test — Result &amp; Answer Key</div>');
  h.push('<div style="font-size:15px">वृक्षारोपण पोस्ट-टेस्ट — परिणाम एवं उत्तर-कुंजी</div></div>');
  h.push('<div style="border:1px solid #D3DDCF;border-top:0;padding:18px 20px;border-radius:0 0 12px 12px">');
  h.push('<p style="margin:0 0 6px"><b>' + esc_(p.info.name) + '</b>' + (p.info.role ? " · " + esc_(p.info.role) : "") + (p.info.place ? " · " + esc_(p.info.place) : "") + '</p>');
  h.push('<p style="font-size:28px;font-weight:bold;margin:6px 0">' + r.correct + ' / ' + r.total + ' <span style="font-size:16px;color:' + grey + '">(' + r.pct + '%)</span> ');
  h.push('<span style="font-size:15px;padding:3px 10px;border:2px solid ' + (r.passed ? ok : bad) + ';color:' + (r.passed ? ok : bad) + ';border-radius:8px">' + (r.passed ? "PASSED · उत्तीर्ण" : "NOT PASSED · अनुत्तीर्ण") + '</span></p>');
  h.push('<p style="margin:0">Correct / सही: <b style="color:' + ok + '">' + r.correct + '</b> &nbsp;|&nbsp; Wrong / गलत: <b style="color:' + bad + '">' + r.wrong + '</b> &nbsp;|&nbsp; Not answered / छोड़े: <b>' + r.unanswered + '</b></p>');
  h.push('<p style="margin:4px 0 0;color:' + grey + ';font-size:13px">Pass mark / उत्तीर्णांक: ' + r.passMark + ' of ' + r.total + '. No negative marking / कोई नकारात्मक अंक नहीं।' + (p.timeUp ? " Time ran out — auto-submitted." : "") + '</p>');
  h.push('</div>');
  var P = paper_(p);
  for (var d = 0; d < P.order.length; d++) {
    var i = P.order[d], map = P.opt[i];
    var q = QUESTIONS[i], st = r.per[i], mine = p.answers[i] || [];
    var col = st === "ok" ? ok : st === "bad" ? bad : grey;
    var lbl = st === "ok" ? "✔ Correct · सही" : st === "bad" ? "✘ Wrong · गलत" : "○ Not answered · छोड़ा";
    h.push('<div style="margin-top:14px;border:1px solid #D3DDCF;border-left:5px solid ' + col + ';border-radius:10px;padding:12px 14px">');
    h.push('<div style="font-size:12px;color:' + col + ';font-weight:bold">Q' + (d + 1) + ' · ' + lbl + '</div>');
    h.push('<div style="font-weight:bold;margin-top:4px">' + esc_(q.q.en).replace(/\n/g, "<br>") + '</div>');
    h.push('<div style="color:#58695E">' + esc_(q.q.hi).replace(/\n/g, "<br>") + '</div>');
    h.push('<table cellpadding="5" cellspacing="0" width="100%" style="margin-top:8px;font-size:14px">');
    for (var pos = 0; pos < map.length; pos++) {
      var k = map[pos], isKey = q.ans.indexOf(k) >= 0, picked = mine.indexOf(k) >= 0;
      var mk = isKey && picked ? "✔ your answer" : isKey ? "✔ correct" : picked ? "✘ your answer" : "";
      h.push('<tr' + (isKey ? ' bgcolor="#DDF1E3"' : picked ? ' bgcolor="#F8E0DC"' : '') + '><td valign="top"><b>' + LETTERS[pos] + '</b></td><td>' +
             esc_(q.opts[k].en) + '<br><font color="#58695E">' + esc_(q.opts[k].hi) + '</font></td><td valign="top" nowrap><small>' + mk + '</small></td></tr>');
    }
    h.push('</table>');
    h.push('<div style="background:#FCEFD3;border-radius:8px;padding:8px 10px;margin-top:6px;font-size:14px"><b>Explanation · व्याख्या:</b> ' + esc_(q.exp.en) + '<br>' + esc_(q.exp.hi) + '</div>');
    h.push('<div style="font-size:12px;color:' + grey + ';margin-top:4px">Source · स्रोत: ' + esc_(q.src) + '</div></div>');
  }
  h.push('<p style="font-size:12px;color:' + grey + ';margin-top:16px">This is an automatic email from the BHGY Post-Test. · यह BHGY पोस्ट-टेस्ट की स्वचालित ईमेल है।</p></div>');
  return h.join("");
}

function buildEmailText_(p, r) {
  var L = ["BHGY Plantation Post-Test — Result & Answer Key", "",
           "Name: " + p.info.name, "Score: " + r.correct + "/" + r.total + " (" + r.pct + "%) — " + (r.passed ? "PASSED" : "NOT PASSED"),
           "Correct: " + r.correct + " | Wrong: " + r.wrong + " | Not answered: " + r.unanswered, ""];
  var P = paper_(p);
  for (var d = 0; d < P.order.length; d++) {
    var i = P.order[d], q = QUESTIONS[i], map = P.opt[i];
    L.push("Q" + (d + 1) + ". " + q.q.en.replace(/\n/g, " "));
    L.push("Correct: " + map.filter(function (k) { return q.ans.indexOf(k) >= 0; })
      .map(function (k) { return LETTERS[map.indexOf(k)] + ". " + q.opts[k].en; }).join("; "));
    L.push("Explanation: " + q.exp.en); L.push("");
  }
  return L.join("\n");
}

/** Run once from the editor to authorise email + sheet access and create the results sheet. */
function setup() {
  logResult_({ info: { name: "SETUP TEST", email: Session.getActiveUser().getEmail() }, answers: [], startedAt: 0, submittedAt: 0 }, scoreAnswers_([], paper_({}).order));
  var id = PropertiesService.getScriptProperties().getProperty("SHEET_ID");
  Logger.log("Results sheet: https://docs.google.com/spreadsheets/d/" + id);
  Logger.log("Emails left today: " + MailApp.getRemainingDailyQuota());
}
